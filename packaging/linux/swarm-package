#!/bin/sh
set -eu

action=${1:-}
bundle=${2:-}
home_dir=${HOME:?HOME is required}
install_root=${SWARM_INSTALL_ROOT:-"$home_dir/.local/lib/swarm"}
config_root=${SWARM_CONFIG_ROOT:-"$home_dir/.config/swarm"}
state_root=${SWARM_STATE_ROOT:-"$home_dir/.local/state/swarm"}
unit_root=${SWARM_SYSTEMD_USER_ROOT:-"$home_dir/.config/systemd/user"}
bin_root=${SWARM_BIN_ROOT:-"$home_dir/.local/bin"}
systemctl_bin=${SWARM_SYSTEMCTL_BIN:-systemctl}
curl_bin=${SWARM_CURL_BIN:-curl}
health_url=${SWARM_HEALTH_URL:-http://127.0.0.1:8766/health}
# The page a person opens, as opposed to the endpoint the installer polls.
app_url=${health_url%/health}
health_attempts=${SWARM_HEALTH_ATTEMPTS:-30}
workspace_root=${SWARM_WORKSPACE_ROOT:-}
[ -n "$workspace_root" ] || workspace_root=$(sed -n 's/^SWARM_WORKSPACE_ROOTS=//p' "$config_root/swarm.env" 2>/dev/null || true)
[ -n "$workspace_root" ] || workspace_root="$home_dir/swarm-workspaces"
drain_release=
rollback_release=
rollback_host_release=
restore_rollback=
restore_candidate=
restore_auth=
restore_incoming=
daily_incoming=
daily_auth=
daily_status=
update_rollback=
update_schema_before=
update_auth=
return_auth=
update_incoming=
dev_config="$config_root/swarm-dev.env"
dev_reload_started=
dev_status_path=
dev_build_root=
dev_reload_revision=

# THE FAILURE RECORD — one shape, every path.
#
# 87 of this script's failures call die() and 6 of them used to reach a status
# file. The other 81 spoke only to the journal, which is why a reload that was
# refused at install and a reload that genuinely did not compile arrived at the
# operator as the same sentence, and why finding out which took a chain of
# journalctl queries. That is the complaint this exists to answer.
#
# RECORDED AT THE EXIT, NOT AT THE THROW. Everything ends in on_exit — die()
# exits, and `set -e` aborts do too — so writing the record there covers the
# paths nobody remembered to instrument as well as the ones they did. A helper
# that each die() had to call would only ever cover the calls someone updated.
#
# The four fields are the four questions an operator asks, in order:
#   step    which part failed, named the way they think of it, not internally
#   detail  what the failing thing itself said — its words, not our paraphrase
#   changed whether anything was left different: nothing / rolled-back / partial
#   next    the command that moves forward, when one exists
#
# `changed` is MAINTAINED BY THE CODE THAT CHANGES THINGS rather than concluded
# afterwards. A surface saying "nothing was changed" when it never looked is the
# same defect as saying "did not compile" about a build that compiled.
fail_step=
fail_detail=
fail_changed=nothing
fail_next=
fail_status=
fail_stamp=

# The detail is the message unless a step already captured something better —
# a compiler's own error line beats this function's summary of it.
die() {
  [ -n "$fail_detail" ] || fail_detail="swarm-package: $*"
  printf 'swarm-package: %s\n' "$*" >&2
  exit 1
}

# One line per field, and the value stripped of newlines because these files are
# parsed as key=value: a detail carrying a newline becomes a key of its own and
# silently corrupts every field after it.
record_failure() {
  [ -n "$1" ] || return 0
  {
    printf 'state=failed\n'
    [ -z "$fail_stamp" ] || printf '%s\n' "$fail_stamp"
    printf 'step=%s\n' "${fail_step:-unknown}"
    printf 'detail=%s\n' "$(printf '%s' "$fail_detail" | tr -d '\r' | tr '\n' ' ' | cut -c1-300)"
    printf 'changed=%s\n' "$fail_changed"
    [ -z "$fail_next" ] || printf 'next=%s\n' "$fail_next"
  } > "$1" 2>/dev/null || true
}
run_systemctl() { "$systemctl_bin" --user "$@"; }

# Stop the whole stack, and CONFIRM IT STOPPED.
#
# `systemctl stop swarm.target` completes when the TARGET is inactive. The
# units it pulls down through PartOf= are separate jobs, and a job that has not
# started yet can be dropped by a daemon-reload. That is not theoretical:
# 2026-08-28 09:17:04 on the operator's machine, from the user manager's own
# journal --
#
#   Stopped target swarm.target
#   Stopping swarm-api.service...            <- already started, so it finished
#   Reload requested from client PID 5251    <- install_units, mid-stop
#   (swarm-terminal-host.service: never mentioned at all)
#
# The API's stop was in flight and completed. The terminal host's was still
# queued, the reload dropped it, and a protocol-9 host stayed alive into a
# protocol-10 world. The new swarmctl got "Broken pipe", wait_for_host spun for
# four minutes, and the failure was reported as health verification. Three
# installs failed that way and none of them said why.
#
# So the units are NAMED rather than left to propagation, and then the stop is
# ASSERTED rather than trusted. `|| true` used to hide the whole thing.
stop_swarm_stack() {
  run_systemctl stop swarm-api.service swarm-terminal-host.service swarm.target >/dev/null 2>&1 || true
  for stopping_unit in swarm-api.service swarm-terminal-host.service; do
    stop_attempts=0
    while run_systemctl is-active --quiet "$stopping_unit" 2>/dev/null; do
      stop_attempts=$((stop_attempts + 1))
      if [ "$stop_attempts" -ge 60 ]; then
        die "$stopping_unit is still running after being asked to stop; refusing to swap the release underneath it"
      fi
      # RE-ISSUED, NOT JUST WAITED ON. A unit that is slow to stop only needs
      # time; a unit whose stop job was DROPPED will never stop no matter how
      # long this waits, and waiting was the whole failure. Asking again costs
      # nothing when the first ask is still working.
      [ $((stop_attempts % 10)) -ne 0 ] \
        || run_systemctl stop "$stopping_unit" >/dev/null 2>&1 || true
      sleep 1
    done
  done
}
# OPTION C: a deferral that never ends must eventually say so.
#
# Deferring is correct while a worker is mid-turn, and this runs every two
# minutes, so a silent deferral is indistinguishable from a healthy pass. That
# is exactly how the running_sessions deadlock went unnoticed for months: the
# timer completed, printed a reassuring line, and nothing ever landed.
#
# The ceiling does not force the update through. It refuses to stay quiet.
# Counted per KIND, because an engine reconcile and a protocol migration defer
# for different reasons and one clearing must not silence the other.
deferral_file() { printf '%s/%s-deferrals\n' "$state_root" "$1"; }

note_deferral() {
  deferral_kind=$1
  deferral_subject=$2
  deferral_detail=$3
  file=$(deferral_file "$deferral_kind")
  count=0
  [ -f "$file" ] && count=$(cat "$file" 2>/dev/null || echo 0)
  case "$count" in *[!0-9]*|"") count=0;; esac
  count=$((count + 1))
  mkdir -p "$state_root" 2>/dev/null || true
  printf '%s\n' "$count" > "$file" 2>/dev/null || true
  # THIRTY GUARANTEED SILENCE IN EVERY CASE ANYONE HAS SEEN. This runs on a
  # ~3-minute timer, so thirty consecutive declines is ninety minutes before the
  # first word. The two real episodes on 2026-09-03 deferred three times and
  # seventeen times; both landed well inside the ceiling and printed nothing.
  #
  # Three is one deferral short of ten minutes of waiting, which is long enough
  # that it is not chatter and short enough that a stall is visible while it is
  # still a stall. The variable stays overridable for anyone who disagrees.
  if [ "$count" -ge "${SWARM_RECONCILE_DEFERRAL_CEILING:-3}" ]; then
    printf 'WARNING: %s has been deferred %s times in a row and has never landed; %s\n' \
      "$deferral_subject" "$count" "$deferral_detail" >&2
  fi
}

clear_deferrals() { rm -f "$(deferral_file "$1")" 2>/dev/null || true; }

# WHAT IS BUSY AND WHAT COULD NOT BE READ, from one status payload.
#
# Both values may come back EMPTY, and empty is not zero: a host too old to
# classify omits the keys entirely. Every caller has to decide what to do about
# that, and they do NOT all decide the same way -- see the two call sites.
read_session_activity() {
  activity_status=$1
  busy=$(printf '%s\n' "$activity_status" | sed -n 's/.*"busy_sessions":[[:space:]]*\([0-9][0-9]*\).*/\1/p')
  unreadable=$(printf '%s\n' "$activity_status" | sed -n 's/.*"unreadable_sessions":[[:space:]]*\([0-9][0-9]*\).*/\1/p')
}

terminal_socket() { printf '%s/swarm/terminal.sock\n' "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"; }

# The one line worth showing from ANY failed step, bounded and newline-free.
#
# Shared by the development reload and the release install: both delegate to a
# tool that explains itself on stderr, and both used to throw that explanation
# away.
#
# THE FIRST STRONG MATCH, NOT THE LAST. Cargo prints the cause first and a
# summary last: `error[E0433]: failed to resolve` then `error: could not
# compile \`swarm-api\` due to 1 previous error`. Taking the last match hands the
# operator the summary, which names no file and no reason and is exactly the
# uninformative sentence this whole mechanism exists to replace.
#
# Three tiers, because not every tool announces itself the same way: a line that
# opens with an error marker, else the first line merely mentioning a failure
# (vite says "Could not resolve" with no marker), else the last non-empty line
# so something always reaches the operator.
#
# Bounded and stripped of newlines because the status file is parsed as
# key=value — a detail carrying a newline becomes a key of its own and corrupts
# every field after it.
last_error() {
  awk '
    cause == "" && /^(error(\[|:)|Error:|swarm-package:)/ { cause = $0 }
    weak == "" && /error|cannot|Cannot|failed|refus/ { weak = $0 }
    NF { last = $0 }
    END { print (cause != "" ? cause : (weak != "" ? weak : last)) }
  ' "$1" 2>/dev/null | tr -d '\r' | tr '\n' ' ' | cut -c1-300
}

# Every authenticated command in this script shares this output boundary.
#
# WHY THIS EXISTS. e74affc made a failing step's stderr into `detail`, a field
# rendered on a card. That was the right fix for "it is taking a lot of work to
# find errors", and it quietly changed the trust boundary of every byte those
# commands print: what used to reach only a 0600 journal now reaches a surface.
# curl is called with --config naming a file that contains
# `header = "Authorization: Bearer <the operator token>"`.
#
# MEASURED, NOT ASSUMED. curl 8.5.0 does not echo config contents for our shape
# on any failure tried — connection refused, HTTP error, unreadable config,
# malformed config, unwritable output. It echoes an argument only when the
# secret is written AS an option, which is not how we write it.
#
# That measurement is not the guarantee. It is one version of one tool, and the
# guarantee has to hold for the next one. So the credential-bearing command's
# output does not enter the captured stream AT ALL: it goes to a private file
# that is deleted, and what reaches the operator is curl's exit code translated
# into a sentence. Nothing this function emits is derived from curl's output,
# which is a property of the code rather than a property of curl.
#
# NOT A DENYLIST. Nothing here scans for things that look like secrets. A
# pattern that misses one shape reads as protection and is not, and this Hive
# has spent a day removing checks that could not fail.
authenticated_curl() {
  auth_file=$1
  shift
  curl_noise="$state_root/.curl-stderr-$$"
  curl_status=0
  # `|| status=$?` rather than `if`: POSIX exempts a command failing inside an
  # AND-OR list from `set -e`, so this records the code instead of aborting.
  "$curl_bin" --config "$auth_file" "$@" 2>"$curl_noise" || curl_status=$?
  rm -f "$curl_noise"
  [ "$curl_status" -eq 0 ] && return 0
  # curl's documented exit codes, which are curl's own vocabulary and carry no
  # bytes from the request. This tells the operator MORE than the raw stderr
  # line did, not less.
  case "$curl_status" in
    7)  curl_meaning="the API is not reachable";;
    22) curl_meaning="the API refused the request";;
    28) curl_meaning="the API did not answer in time";;
    23|26) curl_meaning="a local file could not be read or written";;
    *)  curl_meaning="the request failed";;
  esac
  printf 'swarm-package: %s (curl exit %s). Its output is withheld because this request carries the operator token.\n' \
    "$curl_meaning" "$curl_status" >&2
  return 1
}

# The schema a database file is at, without opening it.
#
# user_version is a 4-byte big-endian integer at offset 60 of the SQLite
# header — a documented, stable part of the file format. Read as raw bytes
# rather than with od --endian so this does not depend on a coreutils version,
# and without sqlite3 so it works on a box that has never had it installed.
database_schema_version() {
  [ -f "$1" ] || return 1
  # THE MAGIC IS CHECKED FIRST BECAUSE OFFSET 60 EXISTS IN EVERY FILE. Without
  # it this reads four arbitrary bytes out of whatever it was handed and
  # returns them as a schema number, which is worse than failing: the caller
  # compares that number and decides whether to warn the operator that their
  # database is unreadable.
  case $(od -An -c -N15 "$1" 2>/dev/null | tr -d ' \n') in
    'SQLiteformat3') :;;
    *) return 1;;
  esac
  schema_bytes=$(od -An -tx1 -j60 -N4 "$1" 2>/dev/null | tr -d ' \n')
  [ ${#schema_bytes} -eq 8 ] || return 1
  printf '%d\n' "0x$schema_bytes"
}

# The newest schema a release understands, asked of the release itself.
#
# Measured rather than assumed: the binary is handed a path that does not
# exist, opens it, migrates the empty database to its own current schema, and
# the answer is read back out of the file. No table is touched and no existing
# database is opened, so this is safe to run against a live Hive.
release_schema_version() {
  [ -x "$1/bin/swarmctl" ] || return 1
  schema_probe="$state_root/.schema-probe-$$.sqlite3"
  rm -f "$schema_probe" "$schema_probe-wal" "$schema_probe-shm"
  if ! "$1/bin/swarmctl" verify-database "$schema_probe" >/dev/null 2>&1; then
    rm -f "$schema_probe" "$schema_probe-wal" "$schema_probe-shm"
    return 1
  fi
  probed=$(database_schema_version "$schema_probe" || printf '')
  rm -f "$schema_probe" "$schema_probe-wal" "$schema_probe-shm"
  [ -n "$probed" ] || return 1
  printf '%s\n' "$probed"
}

# A UNIT THAT HAS HIT ITS START LIMIT REFUSES TO START, AND SAYS SO IN WORDS
# NOBODY CONNECTS TO AN UPDATE.
#
# systemd gives up after enough rapid failures and answers every later start
# with "start request repeated too quickly". On 2026-08-27 a developer's API
# crash-looped 459 times, and from then on EVERY install failed here — not
# because the new release was bad, but because the unit was latched failed
# from the old one. Nothing in the updater cleared it, so the one action that
# would have let her install her way out was the one action she had no way to
# discover.
#
# Announced rather than done quietly: an operator watching an update needs to
# know the unit was in a failed state, because that is a fact about the run
# before this one and it does not otherwise appear anywhere they will look.
clear_start_limit() {
  for limited_unit in "$@"; do
    if run_systemctl is-failed --quiet "$limited_unit" 2>/dev/null; then
      printf 'swarm-package: %s was latched in a failed state; clearing it before starting\n' \
        "$limited_unit" >&2
      run_systemctl reset-failed "$limited_unit" >/dev/null 2>&1 || true
    fi
  done
}

stop_restore_api() {
  run_systemctl stop swarm-api.service || return 1
  restore_api_state=$(run_systemctl show swarm-api.service --property=ActiveState --value) || return 1
  case "$restore_api_state" in inactive|failed) return 0;; *) return 1;; esac
}

rollback_restore_database() {
  stop_restore_api || return 1
  restore_replacement=$(mktemp "$state_root/.restore-return-XXXXXX.sqlite3") || return 1
  if ! cp "$restore_rollback" "$restore_replacement" || ! chmod 0600 "$restore_replacement"; then
    rm -f "$restore_replacement"
    return 1
  fi
  if ! mv -f "$restore_replacement" "$state_root/swarm.sqlite3"; then
    rm -f "$restore_replacement"
    return 1
  fi
  rm -f "$state_root/swarm.sqlite3-wal" "$state_root/swarm.sqlite3-shm" || return 1
  run_systemctl start swarm-api.service || return 1
  wait_for_health || return 1
}

on_exit() {
  result=$?
  trap - EXIT
  [ -z "$restore_auth" ] || rm -f "$restore_auth"
  [ -z "$restore_incoming" ] || rm -f "$restore_incoming"
  [ -z "$restore_candidate" ] || rm -f "$restore_candidate"
  [ -z "$daily_incoming" ] || rm -f "$daily_incoming" "$daily_incoming-wal" "$daily_incoming-shm"
  [ -z "$daily_auth" ] || rm -f "$daily_auth"
  [ -z "$update_auth" ] || rm -f "$update_auth"
  [ -z "$return_auth" ] || rm -f "$return_auth"
  [ -z "$update_incoming" ] || rm -f "$update_incoming"
  if [ -n "$restore_rollback" ] && [ -f "$restore_rollback" ]; then
    if rollback_restore_database; then
      fail_changed=rolled-back
      printf 'Previous database restored and API health verified. Recovery copy: %s\n' "$restore_rollback" >&2
    else
      fail_changed=partial
      printf 'RESTORE ROLLBACK INCOMPLETE. API recovery could not be verified. Recovery copy retained at %s; inspect service state before retrying restore.\n' "$restore_rollback" >&2
    fi
  fi
  # THESE TWO BRANCHES ARE THE ONLY CODE THAT KNOWS A ROLLBACK RAN, so they are
  # what set `changed`. Concluding it anywhere else would be a guess, and a
  # surface telling an operator "nothing was changed" on a guess is the same
  # defect as telling them a build did not compile when it did.
  if [ -n "$rollback_host_release" ] && [ -d "$rollback_host_release" ]; then
    fail_changed=rolled-back
    activate_link "$rollback_release" >/dev/null 2>&1 || true
    activate_host_link "$rollback_host_release" >/dev/null 2>&1 || true
    install_units "$rollback_release" >/dev/null 2>&1 || true
    restore_update_database >/dev/null || true
    run_systemctl enable --now swarm.target >/dev/null 2>&1 || true
  elif [ -n "$rollback_release" ] && [ -d "$rollback_release" ]; then
    fail_changed=rolled-back
    activate_link "$rollback_release" >/dev/null 2>&1 || true
    install_units "$rollback_release" >/dev/null 2>&1 || true
    restore_update_database >/dev/null || true
    run_systemctl restart swarm-api.service >/dev/null 2>&1 || true
  fi
  if [ -n "$drain_release" ]; then
    SWARM_TERMINAL_SOCKET=$(terminal_socket) \
      "$drain_release/bin/swarmctl" cancel-drain >/dev/null 2>&1 || true
  fi
  if [ -n "$dev_reload_started" ] && [ -n "$dev_status_path" ] && [ "$result" -eq 0 ]; then
    printf 'state=ready\nrevision=%s\n' "$dev_reload_revision" > "$dev_status_path" 2>/dev/null || true
  elif [ "$result" -ne 0 ]; then
    # EVERY failing path lands here, including the ones that never thought about
    # a status file. fail_status is empty for an operation that has no surface
    # to report to, and record_failure returns without writing.
    record_failure "$fail_status"
  fi
  if [ "$result" -ne 0 ] && [ -n "$daily_status" ]; then
    record_failure "$daily_status.tmp"
    mv -f "$daily_status.tmp" "$daily_status" 2>/dev/null || true
  fi
  [ -z "$dev_build_root" ] || clear_managed_directory "$dev_build_root"
  exit "$result"
}

prune_update_backups() {
  backup_root="$state_root/backups"
  [ -d "$backup_root" ] || return 0
  # The active operation's recovery copy is mandatory even if the wall clock
  # moved backwards or older files carry future mtimes. Keep two others.
  count=1
  for candidate in $(find "$backup_root" -maxdepth 1 -type f -name 'pre-update-*.sqlite3' -printf '%T@ %p\n' | sort -nr | sed 's/^[^ ]* //'); do
    [ "$candidate" != "$update_rollback" ] || continue
    count=$((count + 1))
    [ "$count" -le 3 ] && continue
    case "$candidate" in "$backup_root"/pre-update-*.sqlite3) rm -f -- "$candidate";; *) die "backup cleanup path escapes managed state";; esac
  done
}

create_update_backup() {
  fail_step=backup
  current_release=$1
  # Used ONLY when the rollback target carries no swarmctl, and then only
  # against a copy. See the verification block below for why it is never the
  # first choice.
  fallback_verifier=${2:-}
  database="$state_root/swarm.sqlite3"
  [ -f "$database" ] || return 0
  # Captured BEFORE the new release can migrate it, so a rollback can tell the
  # difference between "the database is untouched" and "the database moved on
  # and the release we are rolling back to cannot read it".
  update_schema_before=$(database_schema_version "$database" || printf '')
  mkdir -p "$state_root/backups"
  chmod 0700 "$state_root/backups"
  update_incoming="$state_root/.update-backup-$$.sqlite3"
  update_auth="$state_root/.update-auth-$$"
  token=$(sed -n 's/^SWARM_OPERATOR_TOKEN=//p' "$config_root/swarm.env")
  umask 077
  printf 'header = "Authorization: Bearer %s"\n' "$token" > "$update_auth"
  # THE ENDPOINT IS PREFERRED, NOT REQUIRED.
  #
  # Asking the API for the backup takes a consistent snapshot of a database
  # that is being written, which a file copy cannot. But making it the ONLY
  # path meant the repair depended on the thing that was broken: on
  # 2026-08-27 a developer's API could not start, so `update` hung for 135
  # seconds on a connect and then refused, and there was no supported route
  # to install any release. She could run neither the old one nor the new.
  #
  # --connect-timeout so an unreachable API costs five seconds rather than
  # the two minutes she waited before being told anything at all.
  if authenticated_curl "$update_auth" --fail --silent --show-error \
    --connect-timeout 5 --max-time 300 --output "$update_incoming" \
    "${health_url%/health}/api/v1/backups/database"; then
    backup_source=api
  else
    # THE COPY IS SAFE EXACTLY WHEN IT IS NEEDED. It is reached only because
    # the API did not answer, and an API that is not running is not writing
    # the database — so there is no torn read to worry about. A live API
    # never takes this path.
    #
    # The -wal and -shm files come too: in WAL mode the newest committed
    # transactions live in the -wal, and copying the main file alone would
    # produce a backup that silently lost them.
    printf 'API unreachable; copying the database directly for the pre-update backup\n' >&2
    cp -f "$database" "$update_incoming" || die "could not copy the database for the pre-update backup"
    # Written as `if` rather than `[ ... ] && cp` only for legibility -- both
    # are safe here, because `set -e` exempts a command that fails inside an
    # AND-OR list. No -wal beside the database is the ordinary case.
    if [ -f "$database-wal" ]; then cp -f "$database-wal" "$update_incoming-wal"; fi
    if [ -f "$database-shm" ]; then cp -f "$database-shm" "$update_incoming-shm"; fi
    backup_source=copy
  fi
  rm -f "$update_auth"
  update_auth=
  # THE VERIFIER MUST BE THE RELEASE WE WOULD ROLL BACK TO, AND THAT IS NOT A
  # PREFERENCE.
  #
  # verify-database opens the file through TaskStore::open, which MIGRATES
  # anything older than the binary's own schema before checking it. So verify
  # with the new release and the act of verifying rewrites the backup to the
  # new schema -- measured 2026-08-27: a backup taken at 95 came back 102. The
  # rollback then restores a database the old binary refuses to open, which is
  # the unbootable pair of a restored release and a migrated database, and it
  # is produced BY the step that exists to make rollback safe. Both call sites
  # used to pass the new release explicitly, so this had never worked for any
  # release carrying a migration.
  #
  # The old release's schema equals the backup's, so `found < CURRENT` is
  # false, nothing migrates, and verify_integrity still runs in full. The check
  # is not weakened; it is pointed at the binary whose opinion matters.
  #
  # It is also why the API-free copy above is acceptable: verify-database is a
  # binary, not an endpoint, so the check is exactly as strong on a copied file
  # as on a fetched one. Opening the database also folds in any -wal beside it.
  if [ -x "$current_release/bin/swarmctl" ]; then
    "$current_release/bin/swarmctl" verify-database "$update_incoming" >/dev/null \
      || die "pre-update database backup failed verification (source: $backup_source)

The install stopped before changing anything. Copy the database aside yourself and retry:

    cp $state_root/swarm.sqlite3 $home_dir/swarm-database-backup.sqlite3"
  elif [ -n "$fallback_verifier" ] && [ -x "$fallback_verifier/bin/swarmctl" ]; then
    # Verify a COPY, so integrity is still proven and the backup itself is
    # never opened by a newer schema. The copy is byte-identical at the moment
    # it is checked, so the verdict transfers to the file we keep.
    cp -f "$update_incoming" "$update_incoming.check"
    "$fallback_verifier/bin/swarmctl" verify-database "$update_incoming.check" >/dev/null \
      || die "pre-update database backup failed verification (source: $backup_source)

The install stopped before changing anything. Copy the database aside yourself and retry:

    cp $state_root/swarm.sqlite3 $home_dir/swarm-database-backup.sqlite3"
    rm -f "$update_incoming.check" "$update_incoming.check-wal" "$update_incoming.check-shm"
  else
    die "no swarmctl is available to verify the pre-update database backup

The install stopped before changing anything. Copy the database aside yourself and retry:

    cp $state_root/swarm.sqlite3 $home_dir/swarm-database-backup.sqlite3"
  fi
  rm -f "$update_incoming-wal" "$update_incoming-shm"
  update_rollback="$state_root/backups/pre-update-$version.sqlite3"
  chmod 0600 "$update_incoming"
  mv -f "$update_incoming" "$update_rollback"
  update_incoming=
  prune_update_backups
  fail_step=
}

# Put the database back where the release we are rolling back to can read it.
#
# THE OLD BINARY AND THE NEW SCHEMA IS AN UNBOOTABLE HIVE. A release refuses a
# database newer than it understands -- correctly, because the alternative is
# reading rows it has no model for. So a rollback that restores the binary and
# leaves a migrated database has not rolled anything back: it has assembled a
# combination that cannot start, and the operator is left with two releases
# installed and neither of them able to run.
#
# Every exit from here SAYS which of those happened. The version that returned
# 0 in silence is what can turn one failed update into a machine that needs
# hand recovery, because nothing on the way past tells anyone the database has
# been left ahead of the binary.
restore_update_database() {
  database="$state_root/swarm.sqlite3"
  if [ -z "$update_rollback" ]; then
    schema_now=$(database_schema_version "$database" || printf '')
    if [ -n "$schema_now" ] && [ -n "$update_schema_before" ] \
      && [ "$schema_now" -gt "$update_schema_before" ]; then
      # The one case that must never be quiet. There is no backup to restore
      # and the database has moved past the release being restored, so the
      # rollback is about to produce a Hive that will not start. Name the
      # directory rather than pick a file: which backup is the right one is the
      # operator's call, and guessing it for them is how data goes missing.
      printf 'swarm-package: THE ROLLBACK IS INCOMPLETE. The database migrated from schema %s to %s during this update and no pre-update backup exists, so the restored release cannot read it. Restore a backup from %s before starting Swarm:\n\n    swarm-package restore <backup>\n\n' \
        "$update_schema_before" "$schema_now" "$state_root/backups" >&2
    else
      printf 'swarm-package: no pre-update database backup was taken; the database is unchanged and was left as it is\n' >&2
    fi
    return 0
  fi
  [ -f "$update_rollback" ] || die "pre-update rollback backup is missing"
  run_systemctl stop swarm-api.service
  cp "$update_rollback" "$database"
  chmod 0600 "$database"
  rm -f "$database-wal" "$database-shm"
  printf 'swarm-package: restored the pre-update database from %s\n' "$update_rollback" >&2
  update_rollback=
}

clear_managed_directory() {
  managed_directory=$1
  case "$managed_directory" in "$state_root"/*) :;; *) die "cleanup path escapes managed state";; esac
  [ -d "$managed_directory" ] || return 0
  for candidate in "$managed_directory"/* "$managed_directory"/.[!.]* "$managed_directory"/..?*; do
    [ -e "$candidate" ] || continue
    rm -rf -- "$candidate"
  done
}

# A running host owns more than its mapped executable. Future Claude processes
# receive a private SessionStart/SessionEnd hook whose command is the host's
# exact current executable. That path is deliberately version-matched to the
# process and can be invoked minutes or days after the provider starts. Deleting
# the release beneath a live host therefore leaves every later callback pointing
# at `(deleted)`, even though Linux quite correctly keeps the host itself alive.
#
# Keep four when necessary: current, previous, host-current, and the release the
# live host process is actually executing. Once the host restarts, the old path
# stops being reported and the next bounded prune removes it normally.
release_serves_running_host() {
  candidate_release=$1
  if [ -n "${SWARM_RUNNING_HOST_RELEASE:-}" ] \
    && [ "$candidate_release" = "$SWARM_RUNNING_HOST_RELEASE" ]; then
    return 0
  fi
  for process_executable in /proc/[0-9]*/exe; do
    running_executable=$(readlink "$process_executable" 2>/dev/null || true)
    running_executable=${running_executable% (deleted)}
    [ "$running_executable" != "$candidate_release/bin/swarm-terminal-host" ] || return 0
  done
  return 1
}

prune_superseded_releases() {
  releases_root="$install_root/releases"
  [ -d "$releases_root" ] || return 0
  keep_current=$(release_from_link "$install_root/current")
  keep_previous=$(release_from_link "$install_root/previous")
  keep_host=$(release_from_link "$install_root/host-current")
  for candidate in "$releases_root"/*; do
    [ -d "$candidate" ] || continue
    case "$candidate" in
      "$keep_current"|"$keep_previous"|"$keep_host") continue;;
      "$releases_root"/*)
        release_serves_running_host "$candidate" && continue
        rm -rf -- "$candidate"
        ;;
      *) die "release cleanup path escapes managed releases";;
    esac
  done
}

record_daily_backup_ready() {
  {
    printf 'state=ready\n'
    printf 'snapshot_day=%s\n' "$daily_day"
  } > "$daily_status.tmp"
  mv -f "$daily_status.tmp" "$daily_status"
}

daily_database_backup() {
  current=$(release_from_link "$install_root/current")
  [ -n "$current" ] || die "no current release is installed"
  umask 077
  mkdir -p "$state_root/backups"
  chmod 0700 "$state_root/backups"
  # A process-owned, nonblocking lock prevents timer/manual duplicate work.
  exec 9>"$state_root/.daily-backup.lock"
  flock -n 9 || return 0
  daily_status="$state_root/daily-backup.status"
  fail_step=daily-backup
  trap 'exit 143' TERM
  trap 'exit 130' INT
  daily_day=$(date -u +%Y%m%d)
  daily_saved="$state_root/backups/daily-$daily_day.sqlite3"
  if [ -f "$daily_saved" ]; then record_daily_backup_ready; return 0; fi
  # Fixed, lock-owned staging bounds remnants even after an uncatchable kill.
  daily_incoming="$state_root/.daily-incoming.sqlite3"
  daily_auth="$state_root/.daily-auth"
  [ ! -L "$daily_incoming" ] && [ ! -L "$daily_auth" ] || die "daily backup staging must not be a symbolic link"
  rm -f "$daily_incoming" "$daily_incoming-wal" "$daily_incoming-shm" "$daily_auth"
  : > "$daily_incoming"
  : > "$daily_auth"
  token=$(sed -n 's/^SWARM_OPERATOR_TOKEN=//p' "$config_root/swarm.env")
  printf 'header = "Authorization: Bearer %s"\n' "$token" > "$daily_auth"
  authenticated_curl "$daily_auth" --fail --silent --show-error --max-time 120 --max-filesize 2147483648 \
    --output "$daily_incoming" "${health_url%/health}/api/v1/backups/database" \
    || die "daily database backup could not be downloaded; retained snapshots were not changed"
  rm -f "$daily_auth"
  daily_auth=
  timeout 60 "$current/bin/swarmctl" verify-database "$daily_incoming" >/dev/null \
    || die "daily database backup failed verification; retained snapshots were not changed"
  chmod 0600 "$daily_incoming"
  mv "$daily_incoming" "$daily_saved"
  daily_incoming=
  count=1
  for candidate in $(find "$state_root/backups" -maxdepth 1 -type f -name 'daily-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].sqlite3' -printf '%T@ %p\n' | sort -nr | sed 's/^[^ ]* //'); do
    [ "$candidate" != "$daily_saved" ] || continue
    count=$((count + 1))
    [ "$count" -le 7 ] && continue
    case "$candidate" in "$state_root"/backups/daily-*.sqlite3) rm -f -- "$candidate";; *) die "daily backup cleanup path escapes managed state";; esac
  done
  record_daily_backup_ready
  printf 'Daily Hive database backup verified: %s\n' "$daily_saved"
}

restore_database() {
  backup=$bundle
  case "$backup" in "$home_dir"/*) :;; *) die "restore input must remain below HOME";; esac
  case "$backup" in *[!A-Za-z0-9_./-]*) die "restore input contains unsupported characters";; esac
  [ -f "$backup" ] || die "restore database is missing"
  current=$(release_from_link "$install_root/current")
  [ -n "$current" ] || die "no current release is installed"
  umask 077
  restore_incoming=$(mktemp "$state_root/.restore-incoming-XXXXXX.sqlite3")
  cp "$backup" "$restore_incoming"
  # Verification can migrate an older schema. Only the installation candidate
  # may change; the operator's selected recovery file must remain untouched.
  "$current/bin/swarmctl" verify-database "$restore_incoming" >/dev/null || die "restore database failed integrity verification"
  database="$state_root/swarm.sqlite3"
  restore_candidate=$(mktemp "$state_root/.restore-candidate-XXXXXX.sqlite3")
  restore_auth="$state_root/.restore-auth-$$"
  token=$(sed -n 's/^SWARM_OPERATOR_TOKEN=//p' "$config_root/swarm.env")
  umask 077
  printf 'header = "Authorization: Bearer %s"\n' "$token" > "$restore_auth"
  authenticated_curl "$restore_auth" --fail --silent --show-error \
    --output "$restore_candidate" "${health_url%/health}/api/v1/backups/database" \
    || die "could not create the pre-restore rollback backup"
  rm -f "$restore_auth"
  restore_auth=
  "$current/bin/swarmctl" verify-database "$restore_candidate" >/dev/null || die "pre-restore rollback backup failed verification"
  # Arm rollback only after a complete, verified snapshot exists. A partial
  # download or failed check must never be copied over the live database by EXIT.
  mkdir -p "$state_root/backups"
  chmod 0700 "$state_root/backups"
  restore_saved="$state_root/backups/pre-restore-$(date -u +%Y%m%dT%H%M%S)-$$.sqlite3"
  mv "$restore_candidate" "$restore_saved"
  restore_candidate=
  stop_restore_api || die "API stop could not be confirmed; database was not replaced. Recovery copy retained at $restore_saved"
  restore_rollback=$restore_saved
  chmod 0600 "$restore_incoming"
  mv -f "$restore_incoming" "$database"
  restore_incoming=
  rm -f "$database-wal" "$database-shm"
  run_systemctl start swarm-api.service
  wait_for_health || die "restored API failed health verification; attempting previous database recovery"
  restore_rollback=
  count=1
  for candidate in $(find "$state_root/backups" -maxdepth 1 -type f -name 'pre-restore-*.sqlite3' -printf '%T@ %p\n' | sort -nr | sed 's/^[^ ]* //'); do
    [ "$candidate" != "$restore_saved" ] || continue
    count=$((count + 1))
    [ "$count" -le 3 ] && continue
    case "$candidate" in "$state_root"/backups/pre-restore-*.sqlite3) rm -f -- "$candidate";; *) die "restore backup cleanup path escapes managed state";; esac
  done
  printf 'Hive database restored and verified; terminal host and repositories were preserved. Previous database retained at %s\n' "$restore_saved"
}
trap on_exit EXIT

validate_roots() {
  for managed_root in "$install_root" "$config_root" "$state_root" "$unit_root" "$bin_root"; do
    case "$managed_root" in "$home_dir"/*) :;; *) die "managed paths must remain below HOME";; esac
    case "$managed_root" in *[!A-Za-z0-9_./-]*) die "managed paths contain unsupported characters";; esac
  done
  case "$install_root" in */swarm) :;; *) die "install root must end in /swarm";; esac
  case "$config_root" in */swarm) :;; *) die "config root must end in /swarm";; esac
  case "$state_root" in */swarm) :;; *) die "state root must end in /swarm";; esac
  case "$workspace_root" in /*) :;; *) die "workspace root must be absolute";; esac
  case "$workspace_root" in *[!A-Za-z0-9_./-]*) die "workspace root contains unsupported characters";; esac
  case "$health_attempts" in *[!0-9]*|"") die "health attempts must be an integer";; esac
  [ "$health_attempts" -ge 1 ] && [ "$health_attempts" -le 300 ] || die "health attempts must be from 1 through 300"
}

validate_bundle() {
  [ -d "$bundle" ] || die "release directory is required"
  version=$(cat "$bundle/VERSION")
  protocol=$(cat "$bundle/PROTOCOL")
  case "$version" in *[!0-9A-Za-z._-]*|"") die "invalid release version";; esac
  case "$protocol" in *[!0-9]*|"") die "invalid protocol version";; esac
  [ -x "$bundle/bin/swarm-api" ] || die "swarm-api is missing or not executable"
  [ -x "$bundle/bin/swarm-terminal-host" ] || die "terminal host is missing or not executable"
  [ -x "$bundle/bin/swarmctl" ] || die "swarmctl is missing or not executable"
  [ -x "$bundle/swarm-package" ] || die "packaged updater is missing or not executable"
  [ -f "$bundle/web/index.html" ] || die "compiled web index is missing"
  (cd "$bundle" && sha256sum -c SHA256SUMS >/dev/null) || die "release checksum verification failed"
}

validate_config() {
  config_file="$config_root/swarm.env"
  [ -f "$config_file" ] || die "configuration file is missing"
  [ "$(sed -n 's/^SWARM_API_BIND=//p' "$config_file")" = "127.0.0.1:8766" ] || die "packaged API bind must remain 127.0.0.1:8766"
  [ "$(sed -n 's/^SWARM_WORKSPACE_ROOTS=//p' "$config_file")" = "$workspace_root" ] || die "configured workspace root differs from the service write boundary"
  token=$(sed -n 's/^SWARM_OPERATOR_TOKEN=//p' "$config_file")
  [ "${#token}" -ge 32 ] || die "operator token must contain at least 32 characters"
  chmod 0600 "$config_file"
}

render_unit() {
  source_file=$1
  destination=$2
  unit_dev_checkout=$workspace_root
  if [ -f "$dev_config" ]; then
    configured_checkout=$(sed -n 's/^SWARM_DEV_CHECKOUT=//p' "$dev_config")
    [ -z "$configured_checkout" ] || unit_dev_checkout=$configured_checkout
  fi
  # Every @PLACEHOLDER@ must be substituted here. systemd does not fail on an
  # unrecognised ReadWritePaths= entry, it logs and carries on — so a template
  # using a name this renderer does not know produces a unit that starts and
  # then cannot write where it needs to. Checked after rendering, below.
  sed \
    -e "s|@INSTALL_ROOT@|$install_root|g" \
    -e "s|@CONFIG_ROOT@|$config_root|g" \
    -e "s|@STATE_ROOT@|$state_root|g" \
    -e "s|@UNIT_ROOT@|$unit_root|g" \
    -e "s|@BIN_ROOT@|$bin_root|g" \
    -e "s|@WORKSPACE_ROOT@|$workspace_root|g" \
    -e "s|@DEV_CHECKOUT@|$unit_dev_checkout|g" \
    "$source_file" > "$destination.tmp"
  mv -f "$destination.tmp" "$destination"
}

# Asks the person installing to choose their sign-in token.
#
# Only on a first install, and only when there is a terminal to ask on. An
# update never reaches here because the config already exists, and neither does
# the release-apply unit, which runs detached from any terminal — so this can
# prompt without making unattended installs hang.
#
# Typed input is never echoed and never printed back.
read_chosen_token() {
  [ -t 0 ] && [ -t 2 ] || return 1
  printf '\nChoose a token to sign in to Swarm with.\n' >&2
  printf 'At least 12 characters. Press Enter on its own to have one generated.\n' >&2
  attempts=0
  while [ "$attempts" -lt 3 ]; do
    attempts=$((attempts + 1))
    stty -echo 2>/dev/null || return 1
    printf 'Token: ' >&2
    read -r chosen || { stty echo 2>/dev/null; return 1; }
    printf '\n' >&2
    if [ -z "$chosen" ]; then
      stty echo 2>/dev/null
      printf 'Generating one for you.\n' >&2
      return 1
    fi
    printf 'Again: ' >&2
    read -r confirmation || { stty echo 2>/dev/null; return 1; }
    stty echo 2>/dev/null
    printf '\n' >&2
    if [ "$chosen" != "$confirmation" ]; then
      printf 'Those did not match.\n' >&2
      continue
    fi
    # Anyone holding this can drive every worker on the machine, so a token
    # short enough to guess is worse than the generated one it replaces.
    if [ "${#chosen}" -lt 12 ]; then
      printf 'Too short - at least 12 characters.\n' >&2
      continue
    fi
    case "$chosen" in
      *[!!-~]*) printf 'Use printable characters without spaces.\n' >&2; continue;;
    esac
    return 0
  done
  printf 'Generating one for you.\n' >&2
  return 1
}

write_initial_config() {
  config_file="$config_root/swarm.env"
  [ -e "$config_file" ] && return
  chosen=
  if read_chosen_token; then
    token=$chosen
    chosen_token=1
  else
    token=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
    chosen_token=
  fi
  chosen=
  umask 077
  {
    printf 'SWARM_API_BIND=127.0.0.1:8766\n'
    printf 'SWARM_OPERATOR_TOKEN=%s\n' "$token"
    printf 'SWARM_WORKSPACE_ROOTS=%s\n' "$workspace_root"
  } > "$config_file"
  token=
}

install_release() {
  release="$install_root/releases/$version"
  if [ ! -d "$release" ]; then
    staging="$install_root/releases/.staging-$version-$$"
    mkdir -p "$staging"
    cp -R "$bundle/." "$staging/"
    chmod 0755 "$staging/bin/"* "$staging/swarm-package"
    mv "$staging" "$release"
  fi
  (cd "$release" && sha256sum -c SHA256SUMS >/dev/null) || die "installed release checksum verification failed"
  printf '%s\n' "$release"
}

release_from_link() {
  link=$1
  [ -L "$link" ] || return 0
  release=$(readlink "$link")
  case "$release" in "$install_root/releases/"*) :;; *) die "release link escapes the managed release directory";; esac
  [ -d "$release" ] || die "release link points to a missing directory"
  printf '%s\n' "$release"
}

publish_assets() {
  release=$1
  [ -d "$release/web/assets" ] || return 0
  asset_root="$install_root/assets"
  mkdir -p "$asset_root"
  cp -R "$release/web/assets/." "$asset_root/"
}

activate_link() {
  release=$1
  ln -sfn "$release" "$install_root/current.next"
  mv -Tf "$install_root/current.next" "$install_root/current"
  ln -sfn "$install_root/current/bin/swarmctl" "$bin_root/swarmctl"
  publish_host_launcher
}

publish_host_launcher() {
  [ -L "$install_root/host-current" ] || return 0
  ln -sfn "$install_root/host-current/bin/swarm-terminal-host" "$bin_root/swarm-terminal-host"
}

activate_host_link() {
  release=$1
  ln -sfn "$release" "$install_root/host-current.next"
  mv -Tf "$install_root/host-current.next" "$install_root/host-current"
  publish_host_launcher
}

install_units() {
  unit_release=$1
  for name in swarm-terminal-host.service swarm-api.service swarm-host-reconcile.service swarm-host-reconcile.path swarm-host-reconcile.timer swarm-development-reload.service swarm-development-reload.path swarm-release-apply.service swarm-release-apply.path swarm.target; do
    render_unit "$unit_release/systemd-user/$name.in" "$unit_root/$name"
    if grep -q '@[A-Z_]*@' "$unit_root/$name"; then
      die "$name still contains an unsubstituted placeholder: $(grep -o '@[A-Z_]*@' "$unit_root/$name" | sort -u | tr '\n' ' ')"
    fi
  done
  # This package generation owns these optional units. When rolling back to
  # an older bundle, disable/remove them rather than invoking an unknown action.
  if [ -f "$unit_release/systemd-user/swarm-database-backup.service.in" ]; then
    for name in swarm-database-backup.service swarm-database-backup.timer; do
      render_unit "$unit_release/systemd-user/$name.in" "$unit_root/$name"
    done
  else
    run_systemctl disable --now swarm-database-backup.timer >/dev/null 2>&1 || true
    rm -f "$unit_root/swarm-database-backup.service" "$unit_root/swarm-database-backup.timer"
  fi
  run_systemctl daemon-reload
  if [ -f "$unit_release/systemd-user/swarm-database-backup.service.in" ]; then
    run_systemctl enable --now swarm-database-backup.timer
  fi
}

validate_dev_checkout() {
  requested_checkout=$1
  case "$requested_checkout" in *[!A-Za-z0-9_./-]*) die "development checkout contains unsupported characters";; esac
  dev_checkout=$(readlink -f -- "$requested_checkout") || die "development checkout could not be resolved"
  case "$dev_checkout" in "$home_dir"/*) :;; *) die "development checkout must remain below HOME";; esac
  [ -e "$dev_checkout/.git" ] || die "development checkout must be a Git worktree"
  [ -x "$dev_checkout/packaging/linux/build-development-release.sh" ] || die "development checkout does not contain the reload builder"
}

enable_development() {
  dev_checkout=$bundle
  validate_dev_checkout "$dev_checkout"
  current=$(release_from_link "$install_root/current")
  [ -n "$current" ] || die "no current release is installed"
  umask 077
  {
    printf 'SWARM_DEV_CHECKOUT=%s\n' "$dev_checkout"
    printf 'SWARM_DEV_RELOAD_REQUEST_PATH=%s/development-reload.request\n' "$state_root"
    printf 'SWARM_DEV_RELOAD_STATUS_PATH=%s/development-reload.status\n' "$state_root"
  } > "$dev_config.tmp"
  mv -f "$dev_config.tmp" "$dev_config"
  rm -f "$state_root/development-reload.request"
  printf 'state=idle\n' > "$state_root/development-reload.status"
  install_units "$current"
  run_systemctl enable --now swarm-development-reload.path
  run_systemctl restart swarm-api.service
  wait_for_health || die "development mode could not restart the API"
  printf 'Development reload enabled for %s on %s\n' "$dev_checkout" "$health_url"
}

disable_development() {
  current=$(release_from_link "$install_root/current")
  [ -n "$current" ] || die "no current release is installed"
  run_systemctl disable --now swarm-development-reload.path >/dev/null 2>&1 || true
  rm -f "$dev_config" "$state_root/development-reload.request" "$state_root/development-reload.status"
  install_units "$current"
  run_systemctl restart swarm-api.service
  wait_for_health || die "API did not recover after disabling development mode"
  printf 'Development reload disabled; the current release remains active.\n'
}

# A cheap signature of everything a development build will read.
#
# `status --porcelain` covers added, deleted and untracked files and respects
# .gitignore, so build output under target/, dist/ and node_modules/ does not
# register as a change. `diff HEAD` covers edits to tracked files, which is the
# case that actually bit: a file rewritten in place has the same name, the same
# mode and often the same length.
dev_source_fingerprint() {
  {
    git -C "$1" status --porcelain
    git -C "$1" diff HEAD
  } 2>/dev/null | sha256sum | cut -d' ' -f1
}

reload_development() {
  [ -f "$dev_config" ] || die "development mode is not configured"
  dev_checkout=$(sed -n 's/^SWARM_DEV_CHECKOUT=//p' "$dev_config")
  dev_status_path=$(sed -n 's/^SWARM_DEV_RELOAD_STATUS_PATH=//p' "$dev_config")
  validate_dev_checkout "$dev_checkout"
  [ "$dev_status_path" = "$state_root/development-reload.status" ] || die "development status path is invalid"
  # REFUSED BEFORE THE BUILD, NOT AFTER IT.
  #
  # A reload ends in `update`, and update refuses a protocol change by design.
  # On 2026-08-27 that refusal arrived at the END of a five-minute build, every
  # time, from 10:33 until the release was reverted three hours later — the
  # operator paid for the whole build to be told no.
  #
  # AND THE RELOAD MUST NOT SIMPLY RUN THE MIGRATION INSTEAD. migrate-protocol
  # drains the terminal host and stops every worker; the reload's entire promise
  # is that workers stay online, and its card says so on its face. Quietly
  # killing fourteen live terminals to save a refusal is a far worse trade than
  # the refusal.
  #
  # So it stops here, in seconds, and names the command that does the job along
  # with what that command costs.
  dev_protocol=$(sed -n 's/^pub const PROTOCOL_VERSION: u16 = \([0-9][0-9]*\);/\1/p' \
    "$dev_checkout/crates/swarm-terminal/src/ipc.rs" 2>/dev/null | tr -d '\r')
  dev_host_release=$(release_from_link "$install_root/host-current")
  if [ -n "$dev_protocol" ] && [ -n "$dev_host_release" ] && [ -f "$dev_host_release/PROTOCOL" ] \
    && [ "$(cat "$dev_host_release/PROTOCOL")" != "$dev_protocol" ]; then
    fail_status=$dev_status_path
    fail_stamp="revision=$(git -C "$dev_checkout" rev-parse --short=12 HEAD 2>/dev/null)"
    fail_step=protocol-change
    fail_changed=nothing
    fail_next="migrate-protocol"
    die "this checkout speaks terminal-host protocol $dev_protocol and the installed host speaks $(cat "$dev_host_release/PROTOCOL"), so a reload cannot install it — a reload deliberately leaves the terminal host running, which is what keeps worker terminals alive.

Build and migrate instead, which swaps the API and the host together. It STOPS EVERY WORKER, so do it when they are idle:

    $dev_checkout/packaging/linux/build-development-release.sh $state_root/development-build
    <the printed bundle>/swarm-package migrate-protocol <the printed bundle>"
  fi
  dev_reload_started=1
  dev_reload_revision=$(git -C "$dev_checkout" rev-parse --short=12 HEAD)
  [ -n "$dev_reload_revision" ] || die "development source revision is unavailable"
  fail_status=$dev_status_path
  fail_stamp="revision=$dev_reload_revision"
  printf 'state=building\nrevision=%s\n' "$dev_reload_revision" > "$dev_status_path"
  rm -f "$state_root/development-reload.request"
  dev_build_root="$state_root/development-build"
  mkdir -p "$dev_build_root"
  clear_managed_directory "$dev_build_root"
  # WHICH STEP FAILED, AND WHAT IT SAID, recorded where the control room reads it.
  #
  # Every failure used to reach the operator as "the development working copy
  # did not compile", whatever had actually happened — so a build that compiled
  # perfectly and was then refused at install read as a compiler error, and the
  # only way to learn otherwise was journalctl. The operator: "it is taking a
  # lot of work to find errors."
  dev_log="$state_root/development-reload.log"
  # WHAT THE TREE LOOKED LIKE WHEN THE BUILD STARTED.
  #
  # The revision above is `git rev-parse HEAD`, but the build reads the WORKING
  # TREE — so the stamp names a commit while the bundle contains whatever is on
  # disk. That is usually the point of a development reload and is fine while
  # the disk holds still.
  #
  # It did not hold still on 2026-08-30. A file was edited during a five-minute
  # build, vite read it mid-edit, and the operator's control room came up
  # showing "Swarm hit a problem drawing this view" on every load — a temporal
  # dead zone throw from a half-applied change. The status said
  # revision=42f5f7b5470a, the author's disk typechecked clean, and the running
  # bundle matched neither. Nothing anywhere could have told them apart.
  dev_source_before=$(dev_source_fingerprint "$dev_checkout")
  fail_step=build
  if ! bundle_path=$("$dev_checkout/packaging/linux/build-development-release.sh" "$dev_build_root" 2>"$dev_log"); then
    fail_detail=$(last_error "$dev_log")
    cat "$dev_log" >&2 || true
    die "the development build did not compile"
  fi
  cat "$dev_log" >&2 || true
  [ -d "$bundle_path" ] || die "development builder did not return a release directory"
  # AND WHETHER IT HELD STILL. Checked before INSTALL rather than before the
  # build, because a bundle of unknown provenance is only harmful once it is
  # serving people.
  dev_source_after=$(dev_source_fingerprint "$dev_checkout")
  if [ "$dev_source_before" != "$dev_source_after" ]; then
    fail_step=source-moved
    fail_changed=nothing
    fail_next="reload again"
    die "the working copy changed while this build was running, so the bundle matches neither the revision it is stamped with nor the files on disk now.

Nothing was installed. Reload again once the checkout has stopped moving."
  fi
  fail_step=install
  if ! "$bundle_path/swarm-package" update "$bundle_path" 2>"$dev_log"; then
    fail_detail=$(last_error "$dev_log")
    cat "$dev_log" >&2 || true
    die "the development build compiled but could not be installed"
  fi
  cat "$dev_log" >&2 || true
  fail_step=
}

# Installs a release the operator accepted in the control room.
#
# The API cannot do this itself: installing restarts swarm-api, so the request
# arrives as a file and this runs detached from the process that wrote it. The
# request is consumed before the install starts, so a failure is reported once
# rather than retried forever by the path unit that noticed it.
apply_release() {
  request_path="$state_root/release-apply.request"
  [ -f "$request_path" ] || die "no release install was requested"
  requested=$(tr -d '\r\n' < "$request_path")
  rm -f "$request_path"
  status_path="$state_root/release-apply.status"
  # Stamped with the release it concerns. A status file outlives the attempt
  # that wrote it, so one without a version cannot be told apart from a
  # current result — which is exactly how a failure from an earlier release
  # ended up reported against a later one.
  requested_version=$(basename "$requested")
  case "$requested" in
    "$state_root"/downloads/*) :;;
    *) printf 'state=refused\nversion=%s\nstep=accept\nreason=outside-downloads\nchanged=nothing\n' "$requested_version" > "$status_path"
       die "a release install must name a downloaded release";;
  esac
  [ -d "$requested" ] || {
    printf 'state=refused\nversion=%s\nstep=accept\nreason=missing\nchanged=nothing\n' "$requested_version" > "$status_path"
    die "the requested release directory is not there"
  }
  [ -x "$requested/swarm-package" ] || {
    printf 'state=refused\nversion=%s\nstep=accept\nreason=not-a-release\nchanged=nothing\n' "$requested_version" > "$status_path"
    die "the requested directory is not a Swarm release"
  }
  printf 'state=installing\nversion=%s\n' "$requested_version" > "$status_path"
  # A PROTOCOL CHANGE TAKES THE OTHER COMMAND, and hardcoding `update` here is
  # why the control room could not install one at all. `update` refuses a
  # protocol change by design, so an operator accepting such a release from the
  # control room got the refusal and no route forward.
  #
  # ONE COMMAND FOR EVERY RELEASE, INCLUDING A PROTOCOL CHANGE.
  #
  # This chose migrate-protocol-if-idle for a protocol change, which DEFERS
  # while any session is live and leaves the reconcile timer to finish. That
  # cannot finish: supervise_workers revives an autostart worker within seconds
  # of it stopping, so running_sessions never reaches 0 and the deferral waits
  # forever. Measured on this Hive -- 34 workers, one autostart, every pass
  # reporting "1 sessions are active" after the operator had killed everything.
  #
  # It also made the NEWER Hives the broken ones. Every version in the field
  # hardcodes `update` here, and `update` performs the migration outright, so
  # 0.8.17 through 0.8.19 install a protocol change and 0.9.0 would have hung.
  apply_command=update
  # Carried into the FINAL status too, not only the in-flight one. A status file
  # outlives the attempt that wrote it, and "installed" alone cannot be told
  # apart from an ordinary update -- so the one fact that distinguishes this
  # install, that the terminal host was swapped with the API, would be gone by
  # the time anybody read it.
  migration_marker=
  host_release=$(release_from_link "$install_root/host-current")
  if [ -n "$host_release" ] && [ -f "$host_release/PROTOCOL" ] \
    && [ "$(cat "$host_release/PROTOCOL")" != "$(cat "$requested/PROTOCOL")" ]; then
    migration_marker='protocol_migration=1
'
    printf 'state=installing\nversion=%s\n%s' "$requested_version" "$migration_marker" > "$status_path"
  fi
  # The bundle verifies its own SHA256SUMS on update, so integrity does not
  # depend on whoever wrote the request having been honest.
  #
  # THE INSTALLER'S OWN WORDS ARE KEPT. This used to write `state=failed` and a
  # version and nothing else, so the control room said "The install did not run"
  # and sent the operator to journalctl — for the one path a person is most
  # likely to be standing in front of. The bundle knows exactly why it refused;
  # the only reason that never reached anybody is that nobody caught its stderr.
  apply_log="$state_root/release-apply.log"
  if "$requested/swarm-package" "$apply_command" "$requested" 2>"$apply_log"; then
    cat "$apply_log" >&2 || true
    printf 'state=installed\nversion=%s\n%s' "$requested_version" "$migration_marker" > "$status_path"
    rm -rf "$requested"
  else
    cat "$apply_log" >&2 || true
    fail_status=$status_path
    fail_stamp="version=$requested_version"
    fail_step=$apply_command
    fail_detail=$(last_error "$apply_log")
    # WHAT THE NESTED BUNDLE LEFT BEHIND IS NOT VISIBLE FROM HERE. It runs its
    # own rollback in its own process, and this one cannot see whether that
    # worked. `unknown` is the honest answer; claiming "nothing was changed" —
    # which is what the card said unconditionally — is the guess this task
    # exists to remove.
    fail_changed=$(apply_changed "$requested_version")
    die "the requested release did not install"
  fi
}

# Whether the install left this Hive on a different version, READ BACK rather
# than assumed. The bundle it delegated to has exited by now, so the installed
# VERSION file is evidence and the exit status alone is not.
apply_changed() {
  installed_now=$(cat "$install_root/current/VERSION" 2>/dev/null || true)
  if [ -z "$installed_now" ]; then
    printf 'unknown'
  elif [ "$installed_now" = "$1" ]; then
    printf 'partial'
  else
    printf 'nothing'
  fi
}

wait_for_health() {
  attempts=0
  while [ "$attempts" -lt "$health_attempts" ]; do
    if "$curl_bin" --fail --silent --show-error --max-time 2 "$health_url" >/dev/null; then
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 1
  done
  return 1
}

wait_for_host() {
  host_release=$1
  attempts=0
  while [ "$attempts" -lt "$health_attempts" ]; do
    if SWARM_TERMINAL_SOCKET=$(terminal_socket) "$host_release/bin/swarmctl" status >/dev/null 2>&1; then
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 1
  done
  return 1
}

install_or_update() {
  validate_bundle
  mkdir -p "$install_root/releases" "$config_root" "$state_root/terminal-history" "$state_root/providers/claude" "$unit_root" "$bin_root" "$workspace_root" "$workspace_root/queen"
  chmod 0700 "$config_root" "$state_root"
  write_initial_config
  validate_config
  new_release=$(install_release)
  old_release=$(release_from_link "$install_root/current")
  host_release=$(release_from_link "$install_root/host-current")
  if [ -z "$host_release" ] && [ -n "$old_release" ]; then
    host_release=$old_release
    activate_host_link "$host_release"
  fi
  if [ -n "$host_release" ]; then
    host_protocol=$(cat "$host_release/PROTOCOL")
    # NAMES THE COMMAND, NOT JUST THE CONCEPT. This refusal is correct and is
    # doing its job -- a host and an API speaking different protocols is the
    # failure it exists to prevent. But it used to say only that "an explicit
    # compatibility migration" was required, and migrate-protocol IS that
    # migration and has existed all along. On 2026-08-27 every operator reload
    # died here for three hours and the release was reverted instead, because
    # nothing in the message pointed at the command that would have worked.
    #
    # A procedure nobody can find from the error is barely better than one that
    # does not exist.
    if [ "$host_protocol" != "$protocol" ]; then
      # UPDATE DOES THE MIGRATION RATHER THAN REFUSING IT, and that is the
      # difference between a release a Hive can take and one that strands it.
      #
      # THE REASON IS WHOSE CODE RUNS. A Hive installs a release by handing
      # control to the NEW bundle: swarm-release-apply runs
      # `$current/swarm-package apply-release`, and every version of that
      # ultimately calls `"$requested/swarm-package" update "$requested"`.
      # v0.8.19 hardcodes `update` and never selects migrate-protocol. So on
      # every Hive already in the field, `update` is the ONLY entry point a
      # release can arrive through, and refusing here is refusing the release.
      #
      # The alternative considered and rejected was a two-stage rollout: ship a
      # protocol-unchanged release teaching each Hive to choose
      # migrate-protocol, wait for everyone to take it, then ship the real one.
      # The operator: "I have to count on a bunch of people to run an update,
      # report back, and then I release another update and they update ...
      # there has to be a better way." There is, and this is it.
      #
      # THE GUARD IS NOT WIDENED. Nothing here lets a host and an API run on
      # different protocols; they are swapped together, atomically, by the same
      # activation the explicit command uses. What changes is that `update`
      # stops declining a job it was always able to do.
      #
      # WHAT IT COSTS, said plainly because `update` otherwise promises the
      # opposite: this restarts the terminal host, so every worker session ends.
      # A protocol change cannot be applied any other way -- the API and host
      # must move together -- so the honest thing is to do it and announce it,
      # not to refuse and leave the operator with no route at all.
      printf 'swarm-package: this release changes the terminal-host protocol from %s to %s.\n' \
        "$host_protocol" "$protocol" >&2
      printf 'swarm-package: the API and the worker engine are swapped together, so every worker session ends and workers are brought back afterwards.\n' >&2
      # Drained first so nothing new attaches between here and the swap.
      SWARM_TERMINAL_SOCKET=$(terminal_socket) \
        "$host_release/bin/swarmctl" drain >/dev/null 2>&1 || true
      drain_release=$host_release
      activate_protocol_migration "$new_release"
      return
    fi
  fi
  # When the new release carries the same engine, move host-current onto it
  # rather than leaving it on the release it was installed from. Nothing
  # restarts: the running host keeps its own process, and a symlink move only
  # decides which binary a future start uses — which is byte-for-byte the same
  # behaviour, because the fingerprint says so.
  #
  # Without this the engine card reads "Installed 0.5.0" beside an 0.6.2 app
  # and looks stale, when in fact there was nothing to do.
  if [ -n "$host_release" ] && [ "$host_release" != "$new_release" ] \
    && [ -f "$host_release/WORKER_ENGINE_BUILD_ID" ] && [ -f "$new_release/WORKER_ENGINE_BUILD_ID" ] \
    && [ "$(cat "$host_release/WORKER_ENGINE_BUILD_ID")" = "$(cat "$new_release/WORKER_ENGINE_BUILD_ID")" ]; then
    activate_host_link "$new_release"
    host_release=$new_release
    engine_carried_forward=1
  fi
  # First argument verifies; the second is only a fallback for a copy. The
  # rollback target is what must be able to read the backup afterwards.
  [ -z "$old_release" ] || create_update_backup "$old_release" "$new_release"
  previous_release=$(release_from_link "$install_root/previous")
  [ -z "$previous_release" ] || publish_assets "$previous_release"
  [ -z "$old_release" ] || publish_assets "$old_release"
  publish_assets "$new_release"

  if [ -z "$old_release" ]; then
    activate_link "$new_release"
    activate_host_link "$new_release"
    install_units "$new_release"
    clear_start_limit swarm-api.service swarm.target
    if run_systemctl enable --now swarm.target \
      && run_systemctl enable --now swarm-host-reconcile.path swarm-host-reconcile.timer swarm-release-apply.path \
      && wait_for_health && wait_for_host "$new_release"; then
      prune_superseded_releases
      printf 'Swarm %s is healthy at %s\n' "$version" "$health_url"
      # The install ends at a sign-in wall. Whoever gets here needs to know
      # what to type, and where it is if they did not choose it. The value
      # itself is never printed: this output lands in scrollback and in logs.
      if [ -n "${chosen_token:-}" ]; then
        printf '\nOpen %s and sign in with the token you chose.\n' "$app_url"
      else
        printf '\nOpen %s and sign in. A token was generated for you; read it with:\n\n    sed -n %s %s/swarm.env\n' \
          "$app_url" "'s/^SWARM_OPERATOR_TOKEN=//p'" "$config_root"
      fi
      printf '\nThat token is the only credential and it never leaves this machine.\n'
      return
    fi
    run_systemctl stop swarm.target || true
    die "initial installation failed health verification"
  fi

  [ "$old_release" = "$new_release" ] || ln -sfn "$old_release" "$install_root/previous"
  activate_link "$new_release"
  install_units "$new_release"
  rollback_release=$old_release
  clear_start_limit swarm-api.service swarm.target
  if run_systemctl enable --now swarm.target \
    && run_systemctl enable --now swarm-host-reconcile.path swarm-host-reconcile.timer swarm-release-apply.path \
    && run_systemctl restart swarm-api.service && wait_for_health; then
    rollback_release=
    update_rollback=
    prune_superseded_releases
    if [ -n "${engine_carried_forward:-}" ]; then
      printf 'Swarm API %s is healthy at %s; the worker engine is unchanged and now runs from this release\n' \
        "$version" "$health_url"
    else
      printf 'Swarm API %s is healthy at %s; terminal host %s was preserved\n' \
        "$version" "$health_url" "$(basename "$host_release")"
    fi
    return
  fi
  activate_link "$old_release"
  install_units "$old_release"
  restore_update_database
  clear_start_limit swarm-api.service swarm.target
  run_systemctl restart swarm-api.service
  if wait_for_health; then
    rollback_release=
    die "new API failed health verification; previous API release restored"
  fi
  rollback_release=
  die "new API and previous API both failed health verification"
}

rollback() {
  previous=$(release_from_link "$install_root/previous")
  current=$(release_from_link "$install_root/current")
  host_release=$(release_from_link "$install_root/host-current")
  [ -n "$previous" ] || die "no previous release is retained"
  [ -n "$current" ] || die "no current release is installed"
  [ -n "$host_release" ] || die "no terminal host release is installed"
  [ "$(cat "$previous/PROTOCOL")" = "$(cat "$host_release/PROTOCOL")" ] || die "rollback API is incompatible with the active terminal host"
  # ROLLBACK IS NOT ONLY A BINARY. An update migrates the database before it
  # can fail, so moving the symlink back gives an older API a newer schema,
  # which it refuses -- correctly -- and the unit crash-loops. The operation
  # named "rollback" then leaves a Hive worse off than before it was run, which
  # is exactly what happened on 2026-08-27.
  #
  # Checked BEFORE anything moves, and refused rather than half-done. A
  # rollback that stops and names the missing step costs a command; one that
  # proceeds costs a hand-recovered machine. Naming a backup to restore is as
  # far as this goes -- choosing one is the operator's call, because the wrong
  # choice silently discards work.
  target_schema=$(release_schema_version "$previous" || printf '')
  live_schema=$(database_schema_version "$state_root/swarm.sqlite3" || printf '')
  if [ -n "$target_schema" ] && [ -n "$live_schema" ] && [ "$live_schema" -gt "$target_schema" ]; then
    newest_backup=$(ls -1t "$state_root/backups"/pre-update-*.sqlite3 2>/dev/null | head -1)
    if [ -n "$newest_backup" ]; then
      die "the database is at schema $live_schema and $(basename "$previous") reads $target_schema, so rolling back now would leave a Hive that cannot start. Restore the database first, then roll back:

    swarm-package restore $newest_backup
    swarm-package rollback"
    fi
    die "the database is at schema $live_schema and $(basename "$previous") reads $target_schema, so rolling back now would leave a Hive that cannot start. No pre-update backup is retained in $state_root/backups; restore one with 'swarm-package restore <backup>' before rolling back."
  fi
  rollback_release=$current
  activate_link "$previous"
  ln -sfn "$current" "$install_root/previous"
  install_units "$previous"
  clear_start_limit swarm-api.service swarm.target
  run_systemctl restart swarm-api.service
  wait_for_health || die "rollback release failed health verification"
  rollback_release=
  printf 'Swarm API rolled back to %s; terminal host %s was preserved\n' \
    "$(basename "$previous")" "$(basename "$host_release")"
}

reconcile_host() {
  reconcile_mode=${1:-required}
  current=$(release_from_link "$install_root/current")
  host_release=$(release_from_link "$install_root/host-current")
  [ -n "$current" ] || die "no current release is installed"
  [ -n "$host_release" ] || die "no terminal host release is installed"
  # ASK THE RUNNING PROCESS, NOT THE SYMLINK IT WAS JUST HANDED.
  #
  # This compared $current against $host_release — two symlinks, one of which
  # the installer had just moved. That is a check that cannot fail: whenever
  # the install carried the engine forward, the comparison agreed with itself
  # and reported success whether or not anything had restarted.
  #
  # It gave the right answer for the wrong reason and said a misleading thing
  # while doing it. On 2026-08-27 it logged "Terminal host already uses
  # 0.8.17-dev-68f517e..." while the host process was executing a binary from
  # 0.8.17-dev-93b1d50..., whose release directory had been deleted. The engine
  # was in fact identical — carried forward correctly — but nothing in the
  # message let anyone tell that from a host that had failed to restart, and
  # two readers spent an hour establishing which it was.
  #
  # The host reports host_build_id about ITSELF over its own socket. That is
  # the fact worth comparing, and it is the one that still fails when a swap
  # moved the symlink and the restart did not take.
  desired_engine=$([ -f "$current/WORKER_ENGINE_BUILD_ID" ] && cat "$current/WORKER_ENGINE_BUILD_ID" || echo "")
  running_engine=$(SWARM_TERMINAL_SOCKET=$(terminal_socket) \
    "$host_release/bin/swarmctl" status 2>/dev/null \
    | sed -n 's/.*"host_build_id":"\([0-9a-f]*\)".*/\1/p')
  running_version=$(SWARM_TERMINAL_SOCKET=$(terminal_socket) \
    "$host_release/bin/swarmctl" status 2>/dev/null \
    | sed -n 's/.*"host_version":"\([^"]*\)".*/\1/p')

  if [ -n "$desired_engine" ] && [ -n "$running_engine" ] \
    && [ "$desired_engine" = "$running_engine" ]; then
    # Named by what is RUNNING, not by the release the link points at, so a
    # carried-forward engine and a stale one cannot read the same.
    printf 'Terminal host is running the current engine %s (process started from %s)\n' \
      "$(printf '%s' "$running_engine" | cut -c1-12)" "$running_version"
    return
  fi
  if [ -n "$desired_engine" ] && [ -n "$running_engine" ]; then
    printf 'Terminal host is running engine %s but %s wants %s; swapping\n' \
      "$(printf '%s' "$running_engine" | cut -c1-12)" \
      "$(basename "$current")" \
      "$(printf '%s' "$desired_engine" | cut -c1-12)"
  fi
  # AN UNREACHABLE HOST IS NOT A CURRENT ONE.
  #
  # This compared the two symlinks when it could not reach the host and, if
  # they matched, returned success -- printing "Terminal host link already at
  # X; running engine unknown". It said exactly that at 09:18:12 on
  # 2026-08-28 while a stale protocol-9 host was running and answering nobody,
  # which is how the engine card came to contradict itself.
  #
  # A symlink agreeing with a symlink is not evidence about a process. Say the
  # host is unreachable and stop claiming the engine is current.
  if [ -z "$running_engine" ]; then
    if [ "$current" = "$host_release" ]; then
      printf 'Terminal host is not answering; its engine cannot be confirmed (link is at %s)\n' \
        "$(basename "$current")" >&2
      [ "$reconcile_mode" = "if-idle" ] && return
      die "terminal host is not answering, so its engine cannot be reconciled"
    fi
  fi
  # A protocol change is not this function's to make: it moves host-current
  # alone, and a host speaking a different protocol from the API is the exact
  # pair the guard exists to prevent. It refuses -- but it must not refuse
  # LOUDLY when a migration is already prepared and waiting for idle workers,
  # because this runs on a 2-minute timer and would otherwise fill the journal
  # with a failure for a state that is progressing normally.
  if [ "$(cat "$current/PROTOCOL")" != "$(cat "$host_release/PROTOCOL")" ]; then
    if pending_protocol_release >/dev/null 2>&1; then
      printf 'Terminal host reconciliation is waiting on the prepared protocol migration\n'
      return
    fi
    die "terminal host protocol migration is required"
  fi

  SWARM_TERMINAL_SOCKET=$(terminal_socket) "$host_release/bin/swarmctl" drain >/dev/null
  drain_release=$host_release
  status=$(SWARM_TERMINAL_SOCKET=$(terminal_socket) "$host_release/bin/swarmctl" status)
  running=$(printf '%s\n' "$status" | sed -n 's/.*"running_sessions":[[:space:]]*\([0-9][0-9]*\).*/\1/p')
  case "$running" in *[!0-9]*|"") die "terminal host returned invalid status";; esac

  # WHAT IS BUSY, NOT HOW MANY SESSIONS EXIST.
  #
  # This tested running_sessions, and autostart guarantees that never reaches
  # zero -- so the deferral could not finish and requested maintenance never
  # landed. A session count is a constant here, not a reading.
  #
  # Absent rather than zero is the case that matters: a host too old to answer
  # omits these keys entirely, and reading "no key" as "nobody is busy" would
  # upgrade over live work while believing it had checked. Operator ruling
  # 01a05b83 settles what to do instead -- proceed, and say loudly that it
  # could not check.
  read_session_activity "$status"

  if [ -n "$busy" ] && [ "$busy" -ne 0 ]; then
    if [ "$reconcile_mode" = "if-idle" ]; then
      SWARM_TERMINAL_SOCKET=$(terminal_socket) \
        "$host_release/bin/swarmctl" cancel-drain >/dev/null 2>&1 || true
      drain_release=
      printf 'Terminal host update deferred; %s of %s sessions are mid-turn\n' \
        "$busy" "$running"
      note_deferral host-reconcile "the worker engine update" "$busy sessions are still mid-turn"
      return
    fi
    die "terminal host update deferred; $busy sessions are mid-turn"
  fi

  # CANNOT CHECK MEANS WAIT FOR THE OPERATOR, NOT PROCEED.
  #
  # This proceeded-with-a-warning on a TIMER, and it cost 12 live sessions on
  # 2026-09-01 at 14:48:06. An unattended sweep must not end live work on a
  # guess, so the timer defers.
  #
  # The claim that used to sit here -- that reconcile_host_requested "proceeds
  # regardless of who is busy, the card IS the route out" -- was FALSE when it
  # was written, and it was written by the same commit that made this defer. It
  # named an escape hatch nobody had opened. See the requested arm below, which
  # is now actually one.
  #
  # And "cannot check" is not a rare accident here. On the FIRST release that
  # teaches the host to report busy sessions, the RUNNING host is by definition
  # the older one that cannot answer -- so this arm fires with certainty on the
  # one upgrade it most needs to be right about, on every Hive at once.
  #
  # So it defers and says why, and `worker_engine_update_required` already
  # surfaces it in the card. The operator's own words are pinned in
  # DevelopmentReloadAction.test.tsx: "if you have an update that needs the
  # engine to restart, I should see that notification."
  reconcile_blocked=
  if [ -z "$busy" ]; then
    reconcile_blocked="this terminal host cannot report which sessions are busy, so it was NOT checked"
  elif [ -n "$unreadable" ] && [ "$unreadable" -ne 0 ]; then
    reconcile_blocked="$unreadable of $running sessions run a provider this build cannot read"
  fi
  if [ -n "$reconcile_blocked" ]; then
    if [ "$reconcile_mode" = "if-idle" ]; then
      SWARM_TERMINAL_SOCKET=$(terminal_socket) \
        "$host_release/bin/swarmctl" cancel-drain >/dev/null 2>&1 || true
      drain_release=
      printf 'Terminal host update deferred; %s. Apply it from the worker engine card, which ends every session deliberately.\n' \
        "$reconcile_blocked"
      note_deferral host-reconcile "the worker engine update" "$reconcile_blocked"
      return
    fi
    # THE CARD IS THE ROUTE OUT, AND IT HAD TO BE MADE ONE.
    #
    # The comment above USED TO CLAIM this path "proceeds regardless of who is
    # busy. The card IS the route out." It did not. It fell through to the die
    # below, on the same condition that made the timer defer — so a Hive whose
    # running host is too old to report busy sessions could not update by ANY
    # route: the timer deferred, and the card died.
    #
    # That is not a rare case. It is the FIRST upgrade to a build that reports
    # busy sessions, because the host running at that moment is by definition
    # the older one. Measured 2026-09-02 on the operator's WSL Hive: app and API
    # took 1.2.0, the engine stayed on 1.1.1, and the card spun and reverted
    # with nothing said. I wrote both the false comment and the die.
    #
    # Proceeding here is also what the operator RULED, in 01a05b83 resolved
    # 2026-09-01: "Proceed with a loud warning that says it could not check."
    # That ruling landed four hours AFTER the commit that made this defer, and
    # the code was never reconciled with it.
    #
    # And the risk it was guarding is already gone by the time this runs: the
    # card stops every running session itself and only then writes the request
    # file, which is the same thing the protocol branch of
    # reconcile_host_requested says about its own force path.
    if [ "$reconcile_mode" = "requested" ]; then
      printf 'WARNING: %s; proceeding because the worker engine card asked for this and stopped every session first.\n' \
        "$reconcile_blocked" >&2
    else
      die "terminal host update deferred; $reconcile_blocked"
    fi
  fi
  clear_deferrals host-reconcile

  record_loaded_worker_returns || die "worker engine update deferred: could not record the loaded workers owed a return; no sessions stopped"
  activate_host_link "$current"
  install_units "$current"
  if run_systemctl restart swarm-terminal-host.service && wait_for_host "$current"; then
    drain_release=
    printf 'Terminal host now uses %s\n' "$(basename "$current")"
    return
  fi
  activate_host_link "$host_release"
  install_units "$current"
  run_systemctl restart swarm-terminal-host.service || true
  wait_for_host "$host_release" || true
  drain_release=
  die "terminal host restart failed; previous host release restored"
}

record_loaded_worker_returns() {
  # Empty engines need no return record. Card-requested maintenance already
  # records and stops its loaded workers before asking the package to replace.
  [ "$running" -gt 0 ] || return 0
  [ -f "$config_root/swarm.env" ] || return 1
  mkdir -p "$state_root"
  return_auth="$state_root/.return-auth-$$"
  token=$(sed -n 's/^SWARM_OPERATOR_TOKEN=//p' "$config_root/swarm.env")
  [ -n "$token" ] || return 1
  umask 077
  printf 'header = "Authorization: Bearer %s"\n' "$token" > "$return_auth"
  return_status=0
  authenticated_curl "$return_auth" --fail --silent --show-error \
    --connect-timeout 3 --max-time 10 --request POST --output /dev/null \
    "${health_url%/health}/api/v1/runtime/terminal-host/prepare-return" || return_status=$?
  rm -f "$return_auth"
  return_auth=
  [ "$return_status" -eq 0 ]
}

reconcile_host_requested() {
  request_path="$state_root/worker-engine-maintenance.request"
  # A PENDING PROTOCOL MIGRATION IS THIS UNIT'S JOB TOO.
  #
  # It is the only thing on a timer that already knows how to wait for workers
  # to go idle, and a deferred migration needs exactly that. Handled before the
  # engine check because the migration swaps the engine as part of its own
  # atomic step -- reconciling the host first would move host-current under it.
  if pending_protocol_release >/dev/null 2>&1; then
    if [ -f "$request_path" ]; then
      # The card's force path stops the sessions itself, then writes this file.
      complete_protocol_migration
      rm -f "$request_path"
    else
      complete_protocol_migration if-idle
    fi
    return
  fi
  [ -f "$request_path" ] || { reconcile_host if-idle; return; }
  requested_at=$(sed -n 's/^requested_at=//p' "$request_path")
  now=$(date +%s)
  case "$requested_at" in
    *[!0-9]*|"") rm -f "$request_path"; reconcile_host if-idle; return;;
  esac
  if [ "$requested_at" -gt "$now" ] || [ $((now - requested_at)) -gt 300 ]; then
    rm -f "$request_path"
    reconcile_host if-idle
    return
  fi
  reconcile_host requested
  rm -f "$request_path"
}

# THE ACTIVATION HALF: swap the API and the host together, atomically.
#
# Separated from migrate_protocol so a DEFERRED migration can be completed
# later from the release already installed, without the download the request
# named -- which apply_release deletes, and which a Hive that deferred
# overnight would not still have.
activate_protocol_migration() {
  new_release=$1
  # Taken from the release rather than inherited: completing a DEFERRED
  # migration never ran validate_bundle, so `version` -- which names the
  # pre-migration database backup -- would otherwise be unset, and `set -u`
  # aborts partway through an activation that has already stopped the target.
  version=$(cat "$new_release/VERSION")
  protocol=$(cat "$new_release/PROTOCOL")
  old_release=$(release_from_link "$install_root/current")
  host_release=$(release_from_link "$install_root/host-current")
  [ -n "$old_release" ] || die "no current release is installed"
  [ -n "$host_release" ] || die "no terminal host release is installed"

  create_update_backup "$old_release" "$new_release"

  previous_release=$(release_from_link "$install_root/previous")
  [ -z "$previous_release" ] || publish_assets "$previous_release"
  publish_assets "$old_release"
  publish_assets "$new_release"
  [ "$old_release" = "$new_release" ] || ln -sfn "$old_release" "$install_root/previous"

  rollback_release=$old_release
  rollback_host_release=$host_release
  fail_step=activate
  # A MIGRATION IS NOT AN ORDINARY RESTART, AND 30 SECONDS IS NOT ITS BUDGET.
  #
  # An ordinary update restarts the API and nothing else, so the default is
  # generous for it. This stops the whole stack, swaps the API and the terminal
  # host together, brings both back, and the new API then runs every schema
  # migration between the installed database and its own — 96 through 103 for a
  # Hive coming from 0.8.17. On a slower machine that comfortably exceeds 30
  # attempts of one second.
  #
  # WHAT THAT COST, 2026-08-28: the operator's WSL Hive installed 0.9.0
  # correctly, the health check ran out while the API was still starting, the
  # install was declared failed, and the card told them to go and read the
  # journal. "It said it failed and now I am showing 0.9.0. Your installer is
  # garbage." The install had worked. A timeout that reports a working install
  # as broken is worse than a slow one, and it also triggers a rollback of
  # something that succeeded.
  # DEFERS TO AN EXPLICIT SWARM_HEALTH_ATTEMPTS rather than overriding it. A
  # caller that has already chosen a budget — a harness making a deliberate
  # failure fail fast, or an operator who knows their machine — means it, and
  # ignoring them turned every intentionally-unhealthy migration test into a
  # four-minute wait.
  health_attempts=${SWARM_MIGRATION_HEALTH_ATTEMPTS:-${SWARM_HEALTH_ATTEMPTS:-240}}
  stop_swarm_stack
  activate_link "$new_release"
  activate_host_link "$new_release"
  install_units "$new_release"
  if run_systemctl enable --now swarm.target && wait_for_host "$new_release" && wait_for_health; then
    drain_release=
    rollback_release=
    rollback_host_release=
    update_rollback=
    fail_step=
    rm -f "$state_root/protocol-migration.pending"
    prune_superseded_releases
    printf 'Swarm protocol migrated to %s and is healthy at %s\n' "$(basename "$new_release")" "$health_url"
    return
  fi
  die "protocol migration failed health verification; previous release will be restored"
}

# The release a deferred migration is waiting to activate, or nothing.
#
# Validated as a path inside the managed release root before it is used: this
# file decides what gets activated, and a marker naming somewhere else would
# be an install of whatever wrote it.
pending_protocol_release() {
  pending_file="$state_root/protocol-migration.pending"
  [ -f "$pending_file" ] || return 1
  pending=$(tr -d '\r\n' < "$pending_file")
  case "$pending" in
    "$install_root"/releases/*) :;;
    *) rm -f "$pending_file"; return 1;;
  esac
  [ -d "$pending" ] && [ -f "$pending/PROTOCOL" ] || { rm -f "$pending_file"; return 1; }
  printf '%s' "$pending"
}

migrate_protocol() {
  migrate_mode=${1:-required}
  validate_bundle
  validate_config
  new_release=$(install_release)
  host_release=$(release_from_link "$install_root/host-current")
  [ -n "$host_release" ] || die "no terminal host release is installed"
  [ "$(cat "$host_release/PROTOCOL")" != "$protocol" ] || die "protocol is unchanged; use update and reconcile-host"

  SWARM_TERMINAL_SOCKET=$(terminal_socket) "$host_release/bin/swarmctl" drain >/dev/null
  drain_release=$host_release
  status=$(SWARM_TERMINAL_SOCKET=$(terminal_socket) "$host_release/bin/swarmctl" status)
  running=$(printf '%s\n' "$status" | sed -n 's/.*"running_sessions":[[:space:]]*\([0-9][0-9]*\).*/\1/p')
  case "$running" in *[!0-9]*|"") die "terminal host returned invalid status";; esac
  read_session_activity "$status"

  # DEFERRING ON "I CANNOT TELL" IS THE OPPOSITE ARM TO reconcile_host, AND THE
  # DIFFERENCE IS AN ESCAPE HATCH RATHER THAN A BLAST RADIUS.
  #
  # The reconcile has no human route out: defer it wrongly and worker-engine
  # maintenance never lands, with nobody watching. Proceeding is the only way
  # out, so it proceeds and says what it could not read.
  #
  # A protocol migration HAS a route out. The worker engine card's force path
  # calls complete_protocol_migration WITHOUT if-idle and stops the sessions
  # itself. So deferring here strands nothing -- a person can force it
  # deliberately -- while proceeding would end every live session on a guess.
  #
  # Proceed-on-unknown where there is no human route out; defer-on-unknown
  # where there is.
  migration_blocked=
  if [ -z "$busy" ]; then
    migration_blocked="this host cannot report which sessions are busy, so it was NOT checked"
  elif [ "$busy" -ne 0 ]; then
    migration_blocked="$busy of $running sessions are mid-turn"
  elif [ -n "$unreadable" ] && [ "$unreadable" -ne 0 ]; then
    migration_blocked="$unreadable of $running sessions run a provider this build cannot read"
  fi
  if [ -n "$migration_blocked" ]; then
    # DEFER, DO NOT FAIL. This used to die, and on a Hive with any worker
    # running that made a released protocol change UNINSTALLABLE: apply_release
    # deletes its request file before installing, and swarm-release-apply.path
    # triggers on that file existing, so nothing ever retried. The control room
    # showed a permanent "install failed" and the only way through was for a
    # person to sleep every worker and re-trigger by hand.
    #
    # The worker engine update already had the answer and this did not copy it:
    # cancel the drain, say so, return 0, and let swarm-host-reconcile.timer
    # (every 2 minutes) finish the job when the workers go quiet.
    if [ "$migrate_mode" = "if-idle" ]; then
      SWARM_TERMINAL_SOCKET=$(terminal_socket) \
        "$host_release/bin/swarmctl" cancel-drain >/dev/null 2>&1 || true
      drain_release=
      # The RELEASE is recorded, not the download: apply_release removes the
      # download, and a Hive that defers overnight would have nothing to
      # activate from in the morning.
      printf '%s\n' "$new_release" > "$state_root/protocol-migration.pending"
      printf 'Protocol migration to %s is prepared and deferred; %s. It will apply itself when they are idle, or you can apply it now from the worker engine card.\n' \
        "$version" "$migration_blocked"
      return
    fi
    die "protocol migration deferred; $migration_blocked"
  fi
  clear_deferrals protocol-migration

  activate_protocol_migration "$new_release"
}

# Finish a migration that was prepared earlier and deferred.
complete_protocol_migration() {
  complete_mode=${1:-required}
  pending=$(pending_protocol_release) || { printf 'No protocol migration is pending\n'; return; }
  host_release=$(release_from_link "$install_root/host-current")
  [ -n "$host_release" ] || die "no terminal host release is installed"
  if [ "$(cat "$host_release/PROTOCOL")" = "$(cat "$pending/PROTOCOL")" ]; then
    rm -f "$state_root/protocol-migration.pending"
    printf 'Protocol migration is no longer needed; the host already speaks %s\n' "$(cat "$pending/PROTOCOL")"
    return
  fi
  SWARM_TERMINAL_SOCKET=$(terminal_socket) "$host_release/bin/swarmctl" drain >/dev/null
  drain_release=$host_release
  status=$(SWARM_TERMINAL_SOCKET=$(terminal_socket) "$host_release/bin/swarmctl" status)
  running=$(printf '%s\n' "$status" | sed -n 's/.*"running_sessions":[[:space:]]*\([0-9][0-9]*\).*/\1/p')
  case "$running" in *[!0-9]*|"") die "terminal host returned invalid status";; esac
  read_session_activity "$status"

  # THE UNATTENDED HALF, and the one that decides whether the promise printed
  # by migrate_protocol is ever kept. It runs from swarm-host-reconcile.timer,
  # so "operator-initiated, therefore attended" is reasoning about the wrong
  # half of this command. Same arms as migrate_protocol above.
  completion_blocked=
  if [ -z "$busy" ]; then
    completion_blocked="this host cannot report which sessions are busy, so it was NOT checked"
  elif [ "$busy" -ne 0 ]; then
    completion_blocked="$busy of $running sessions are mid-turn"
  elif [ -n "$unreadable" ] && [ "$unreadable" -ne 0 ]; then
    completion_blocked="$unreadable of $running sessions run a provider this build cannot read"
  fi
  if [ -n "$completion_blocked" ]; then
    if [ "$complete_mode" = "if-idle" ]; then
      SWARM_TERMINAL_SOCKET=$(terminal_socket) \
        "$host_release/bin/swarmctl" cancel-drain >/dev/null 2>&1 || true
      drain_release=
      printf 'Protocol migration remains deferred; %s\n' "$completion_blocked"
      # "It will apply itself when they are idle" is a PROMISE. A deferral that
      # repeats forever quietly makes it false, which is precisely how the
      # previous fix here turned a visible failure into an invisible one.
      note_deferral protocol-migration "the prepared protocol migration" "$completion_blocked"
      return
    fi
    die "protocol migration deferred; $completion_blocked"
  fi
  clear_deferrals protocol-migration
  activate_protocol_migration "$pending"
}

uninstall_product() {
  run_systemctl disable --now swarm.target 2>/dev/null || true
  rm -f "$unit_root/swarm-terminal-host.service" "$unit_root/swarm-api.service" \
    "$unit_root/swarm-host-reconcile.service" "$unit_root/swarm-host-reconcile.path" "$unit_root/swarm-host-reconcile.timer" \
    "$unit_root/swarm-development-reload.service" "$unit_root/swarm-development-reload.path" \
    "$unit_root/swarm-release-apply.service" "$unit_root/swarm-release-apply.path" \
    "$unit_root/swarm-database-backup.service" "$unit_root/swarm-database-backup.timer" \
    "$unit_root/swarm.target"
  run_systemctl daemon-reload
  [ ! -L "$bin_root/swarmctl" ] || rm -f "$bin_root/swarmctl"
  [ ! -L "$bin_root/swarm-terminal-host" ] || rm -f "$bin_root/swarm-terminal-host"
  rm -rf "$install_root"
  printf 'Application removed. Configuration and state were preserved in %s and %s.\n' "$config_root" "$state_root"
}

validate_roots
case "$action" in
  install|update) install_or_update;;
  enable-development) enable_development;;
  disable-development) disable_development;;
  reload-development) reload_development;;
  rollback) rollback;;
  reconcile-host) reconcile_host;;
  reconcile-host-if-idle) reconcile_host if-idle;;
  reconcile-host-requested) reconcile_host_requested;;
  migrate-protocol) migrate_protocol;;
  migrate-protocol-if-idle) migrate_protocol if-idle;;
  complete-protocol-migration) complete_protocol_migration;;
  complete-protocol-migration-if-idle) complete_protocol_migration if-idle;;
  apply-release) apply_release;;
  uninstall) uninstall_product;;
  restore) restore_database;;
  backup-daily) daily_database_backup;;
  *) die "usage: swarm-package <install|update|migrate-protocol> RELEASE_DIR | apply-release | enable-development CHECKOUT | disable-development | reload-development | backup-daily | restore DATABASE | rollback | reconcile-host | reconcile-host-if-idle | reconcile-host-requested | uninstall";;
esac
