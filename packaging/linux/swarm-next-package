#!/bin/sh
set -eu

action=${1:-}
bundle=${2:-}
home_dir=${HOME:?HOME is required}
install_root=${SWARM_INSTALL_ROOT:-"$home_dir/.local/lib/swarm-next"}
config_root=${SWARM_CONFIG_ROOT:-"$home_dir/.config/swarm-next"}
state_root=${SWARM_STATE_ROOT:-"$home_dir/.local/state/swarm-next"}
unit_root=${SWARM_SYSTEMD_USER_ROOT:-"$home_dir/.config/systemd/user"}
bin_root=${SWARM_BIN_ROOT:-"$home_dir/.local/bin"}
systemctl_bin=${SWARM_SYSTEMCTL_BIN:-systemctl}
curl_bin=${SWARM_CURL_BIN:-curl}
health_url=${SWARM_HEALTH_URL:-http://127.0.0.1:8766/health}
health_attempts=${SWARM_HEALTH_ATTEMPTS:-30}
workspace_root=${SWARM_WORKSPACE_ROOT:-}
[ -n "$workspace_root" ] || workspace_root=$(sed -n 's/^SWARM_WORKSPACE_ROOTS=//p' "$config_root/swarm-next.env" 2>/dev/null || true)
[ -n "$workspace_root" ] || workspace_root="$home_dir/swarm-workspaces"
drain_release=
rollback_release=
rollback_host_release=
restore_rollback=
restore_auth=
restore_incoming=
update_rollback=
update_auth=
update_incoming=
dev_config="$config_root/swarm-next-dev.env"
dev_reload_started=
dev_status_path=
dev_build_root=

die() { printf 'swarm-next-package: %s\n' "$*" >&2; exit 1; }
run_systemctl() { "$systemctl_bin" --user "$@"; }
terminal_socket() { printf '%s/swarm-next/terminal.sock\n' "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"; }

on_exit() {
  result=$?
  trap - EXIT
  [ -z "$restore_auth" ] || rm -f "$restore_auth"
  [ -z "$restore_incoming" ] || rm -f "$restore_incoming"
  [ -z "$update_auth" ] || rm -f "$update_auth"
  [ -z "$update_incoming" ] || rm -f "$update_incoming"
  if [ -n "$restore_rollback" ] && [ -f "$restore_rollback" ]; then
    run_systemctl stop swarm-next-api.service >/dev/null 2>&1 || true
    cp "$restore_rollback" "$state_root/swarm-next.sqlite3" >/dev/null 2>&1 || true
    chmod 0600 "$state_root/swarm-next.sqlite3" >/dev/null 2>&1 || true
    rm -f "$state_root/swarm-next.sqlite3-wal" "$state_root/swarm-next.sqlite3-shm"
    run_systemctl start swarm-next-api.service >/dev/null 2>&1 || true
  fi
  if [ -n "$rollback_host_release" ] && [ -d "$rollback_host_release" ]; then
    activate_link "$rollback_release" >/dev/null 2>&1 || true
    activate_host_link "$rollback_host_release" >/dev/null 2>&1 || true
    install_units "$rollback_release" >/dev/null 2>&1 || true
    restore_update_database >/dev/null 2>&1 || true
    run_systemctl enable --now swarm-next.target >/dev/null 2>&1 || true
  elif [ -n "$rollback_release" ] && [ -d "$rollback_release" ]; then
    activate_link "$rollback_release" >/dev/null 2>&1 || true
    install_units "$rollback_release" >/dev/null 2>&1 || true
    restore_update_database >/dev/null 2>&1 || true
    run_systemctl restart swarm-next-api.service >/dev/null 2>&1 || true
  fi
  if [ -n "$drain_release" ]; then
    SWARM_TERMINAL_SOCKET=$(terminal_socket) \
      "$drain_release/bin/swarmctl" cancel-drain >/dev/null 2>&1 || true
  fi
  if [ -n "$dev_reload_started" ] && [ -n "$dev_status_path" ]; then
    if [ "$result" -eq 0 ]; then
      printf 'state=ready\n' > "$dev_status_path" 2>/dev/null || true
    else
      printf 'state=failed\n' > "$dev_status_path" 2>/dev/null || true
    fi
  fi
  [ -z "$dev_build_root" ] || clear_managed_directory "$dev_build_root"
  exit "$result"
}

prune_update_backups() {
  backup_root="$state_root/backups"
  [ -d "$backup_root" ] || return 0
  count=0
  for candidate in $(find "$backup_root" -maxdepth 1 -type f -name 'pre-update-*.sqlite3' -printf '%T@ %p\n' | sort -nr | sed 's/^[^ ]* //'); do
    count=$((count + 1))
    [ "$count" -le 10 ] && continue
    case "$candidate" in "$backup_root"/pre-update-*.sqlite3) rm -f -- "$candidate";; *) die "backup cleanup path escapes managed state";; esac
  done
}

create_update_backup() {
  current_release=$1
  database="$state_root/swarm-next.sqlite3"
  [ -f "$database" ] || return 0
  mkdir -p "$state_root/backups"
  chmod 0700 "$state_root/backups"
  update_incoming="$state_root/.update-backup-$$.sqlite3"
  update_auth="$state_root/.update-auth-$$"
  token=$(sed -n 's/^SWARM_OPERATOR_TOKEN=//p' "$config_root/swarm-next.env")
  umask 077
  printf 'header = "Authorization: Bearer %s"\n' "$token" > "$update_auth"
  "$curl_bin" --fail --silent --show-error --config "$update_auth" --output "$update_incoming" "${health_url%/health}/api/v1/backups/database" || die "could not create the pre-update database backup"
  rm -f "$update_auth"
  update_auth=
  "$current_release/bin/swarmctl" verify-database "$update_incoming" >/dev/null || die "pre-update database backup failed verification"
  update_rollback="$state_root/backups/pre-update-$version.sqlite3"
  chmod 0600 "$update_incoming"
  mv -f "$update_incoming" "$update_rollback"
  update_incoming=
  prune_update_backups
}

restore_update_database() {
  [ -n "$update_rollback" ] || return 0
  [ -f "$update_rollback" ] || die "pre-update rollback backup is missing"
  database="$state_root/swarm-next.sqlite3"
  run_systemctl stop swarm-next-api.service
  cp "$update_rollback" "$database"
  chmod 0600 "$database"
  rm -f "$database-wal" "$database-shm"
  update_rollback=
}

clear_managed_directory() {
  managed_directory=$1
  case "$managed_directory" in "$state_root"/*) :;; *) die "cleanup path escapes managed state";; esac
  [ -d "$managed_directory" ] || return 0
  for candidate in "$managed_directory"/* "$managed_directory"/.[!.]* "$managed_directory"/..?*; do
    [ -e "$candidate" ] || continue
    rm -rf -- "$candidate"
  done
}

prune_superseded_releases() {
  releases_root="$install_root/releases"
  [ -d "$releases_root" ] || return 0
  keep_current=$(release_from_link "$install_root/current")
  keep_previous=$(release_from_link "$install_root/previous")
  keep_host=$(release_from_link "$install_root/host-current")
  for candidate in "$releases_root"/*; do
    [ -d "$candidate" ] || continue
    case "$candidate" in
      "$keep_current"|"$keep_previous"|"$keep_host") continue;;
      "$releases_root"/*) rm -rf -- "$candidate";;
      *) die "release cleanup path escapes managed releases";;
    esac
  done
}

restore_database() {
  backup=$bundle
  case "$backup" in "$home_dir"/*) :;; *) die "restore input must remain below HOME";; esac
  case "$backup" in *[!A-Za-z0-9_./-]*) die "restore input contains unsupported characters";; esac
  [ -f "$backup" ] || die "restore database is missing"
  current=$(release_from_link "$install_root/current")
  [ -n "$current" ] || die "no current release is installed"
  "$current/bin/swarmctl" verify-database "$backup" >/dev/null || die "restore database failed integrity verification"
  database="$state_root/swarm-next.sqlite3"
  restore_rollback="$state_root/.restore-rollback-$$.sqlite3"
  restore_auth="$state_root/.restore-auth-$$"
  token=$(sed -n 's/^SWARM_OPERATOR_TOKEN=//p' "$config_root/swarm-next.env")
  umask 077
  printf 'header = "Authorization: Bearer %s"\n' "$token" > "$restore_auth"
  "$curl_bin" --fail --silent --show-error --config "$restore_auth" --output "$restore_rollback" "${health_url%/health}/api/v1/backups/database" || die "could not create the pre-restore rollback backup"
  rm -f "$restore_auth"
  restore_auth=
  "$current/bin/swarmctl" verify-database "$restore_rollback" >/dev/null || die "pre-restore rollback backup failed verification"
  run_systemctl stop swarm-next-api.service
  restore_incoming="$state_root/.restore-incoming-$$.sqlite3"
  cp "$backup" "$restore_incoming"
  chmod 0600 "$restore_incoming"
  mv -f "$restore_incoming" "$database"
  restore_incoming=
  rm -f "$database-wal" "$database-shm"
  run_systemctl start swarm-next-api.service
  wait_for_health || die "restored API failed health verification; previous database will be restored"
  rm -f "$restore_rollback"
  restore_rollback=
  printf 'Hive database restored and verified; terminal host and repositories were preserved.\n'
}
trap on_exit EXIT

validate_roots() {
  for managed_root in "$install_root" "$config_root" "$state_root" "$unit_root" "$bin_root"; do
    case "$managed_root" in "$home_dir"/*) :;; *) die "managed paths must remain below HOME";; esac
    case "$managed_root" in *[!A-Za-z0-9_./-]*) die "managed paths contain unsupported characters";; esac
  done
  case "$install_root" in */swarm-next) :;; *) die "install root must end in /swarm-next";; esac
  case "$config_root" in */swarm-next) :;; *) die "config root must end in /swarm-next";; esac
  case "$state_root" in */swarm-next) :;; *) die "state root must end in /swarm-next";; esac
  case "$workspace_root" in /*) :;; *) die "workspace root must be absolute";; esac
  case "$workspace_root" in *[!A-Za-z0-9_./-]*) die "workspace root contains unsupported characters";; esac
  case "$health_attempts" in *[!0-9]*|"") die "health attempts must be an integer";; esac
  [ "$health_attempts" -ge 1 ] && [ "$health_attempts" -le 300 ] || die "health attempts must be from 1 through 300"
}

validate_bundle() {
  [ -d "$bundle" ] || die "release directory is required"
  version=$(cat "$bundle/VERSION")
  protocol=$(cat "$bundle/PROTOCOL")
  case "$version" in *[!0-9A-Za-z._-]*|"") die "invalid release version";; esac
  case "$protocol" in *[!0-9]*|"") die "invalid protocol version";; esac
  [ -x "$bundle/bin/swarm-api" ] || die "swarm-api is missing or not executable"
  [ -x "$bundle/bin/swarm-terminal-host" ] || die "terminal host is missing or not executable"
  [ -x "$bundle/bin/swarmctl" ] || die "swarmctl is missing or not executable"
  [ -x "$bundle/swarm-next-package" ] || die "packaged updater is missing or not executable"
  [ -f "$bundle/web/index.html" ] || die "compiled web index is missing"
  (cd "$bundle" && sha256sum -c SHA256SUMS >/dev/null) || die "release checksum verification failed"
}

validate_config() {
  config_file="$config_root/swarm-next.env"
  [ -f "$config_file" ] || die "configuration file is missing"
  [ "$(sed -n 's/^SWARM_API_BIND=//p' "$config_file")" = "127.0.0.1:8766" ] || die "packaged API bind must remain 127.0.0.1:8766"
  [ "$(sed -n 's/^SWARM_WORKSPACE_ROOTS=//p' "$config_file")" = "$workspace_root" ] || die "configured workspace root differs from the service write boundary"
  token=$(sed -n 's/^SWARM_OPERATOR_TOKEN=//p' "$config_file")
  [ "${#token}" -ge 32 ] || die "operator token must contain at least 32 characters"
  chmod 0600 "$config_file"
}

render_unit() {
  source_file=$1
  destination=$2
  unit_dev_checkout=$workspace_root
  if [ -f "$dev_config" ]; then
    configured_checkout=$(sed -n 's/^SWARM_DEV_CHECKOUT=//p' "$dev_config")
    [ -z "$configured_checkout" ] || unit_dev_checkout=$configured_checkout
  fi
  sed \
    -e "s|@INSTALL_ROOT@|$install_root|g" \
    -e "s|@CONFIG_ROOT@|$config_root|g" \
    -e "s|@STATE_ROOT@|$state_root|g" \
    -e "s|@UNIT_ROOT@|$unit_root|g" \
    -e "s|@WORKSPACE_ROOT@|$workspace_root|g" \
    -e "s|@DEV_CHECKOUT@|$unit_dev_checkout|g" \
    "$source_file" > "$destination.tmp"
  mv -f "$destination.tmp" "$destination"
}

write_initial_config() {
  config_file="$config_root/swarm-next.env"
  [ -e "$config_file" ] && return
  token=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
  umask 077
  {
    printf 'SWARM_API_BIND=127.0.0.1:8766\n'
    printf 'SWARM_OPERATOR_TOKEN=%s\n' "$token"
    printf 'SWARM_WORKSPACE_ROOTS=%s\n' "$workspace_root"
  } > "$config_file"
}

install_release() {
  release="$install_root/releases/$version"
  if [ ! -d "$release" ]; then
    staging="$install_root/releases/.staging-$version-$$"
    mkdir -p "$staging"
    cp -R "$bundle/." "$staging/"
    chmod 0755 "$staging/bin/"* "$staging/swarm-next-package"
    mv "$staging" "$release"
  fi
  (cd "$release" && sha256sum -c SHA256SUMS >/dev/null) || die "installed release checksum verification failed"
  printf '%s\n' "$release"
}

release_from_link() {
  link=$1
  [ -L "$link" ] || return 0
  release=$(readlink "$link")
  case "$release" in "$install_root/releases/"*) :;; *) die "release link escapes the managed release directory";; esac
  [ -d "$release" ] || die "release link points to a missing directory"
  printf '%s\n' "$release"
}

publish_assets() {
  release=$1
  [ -d "$release/web/assets" ] || return 0
  asset_root="$install_root/assets"
  mkdir -p "$asset_root"
  cp -R "$release/web/assets/." "$asset_root/"
}

activate_link() {
  release=$1
  ln -sfn "$release" "$install_root/current.next"
  mv -Tf "$install_root/current.next" "$install_root/current"
  ln -sfn "$install_root/current/bin/swarmctl" "$bin_root/swarmctl"
}

activate_host_link() {
  release=$1
  ln -sfn "$release" "$install_root/host-current.next"
  mv -Tf "$install_root/host-current.next" "$install_root/host-current"
}

install_units() {
  unit_release=$1
  for name in swarm-next-terminal-host.service swarm-next-api.service swarm-next-host-reconcile.service swarm-next-host-reconcile.path swarm-next-host-reconcile.timer swarm-next-development-reload.service swarm-next-development-reload.path swarm-next.target; do
    render_unit "$unit_release/systemd-user/$name.in" "$unit_root/$name"
  done
  run_systemctl daemon-reload
}

validate_dev_checkout() {
  requested_checkout=$1
  case "$requested_checkout" in *[!A-Za-z0-9_./-]*) die "development checkout contains unsupported characters";; esac
  dev_checkout=$(readlink -f -- "$requested_checkout") || die "development checkout could not be resolved"
  case "$dev_checkout" in "$home_dir"/*) :;; *) die "development checkout must remain below HOME";; esac
  [ -e "$dev_checkout/.git" ] || die "development checkout must be a Git worktree"
  [ -x "$dev_checkout/packaging/linux/build-development-release.sh" ] || die "development checkout does not contain the reload builder"
}

enable_development() {
  dev_checkout=$bundle
  validate_dev_checkout "$dev_checkout"
  current=$(release_from_link "$install_root/current")
  [ -n "$current" ] || die "no current release is installed"
  umask 077
  {
    printf 'SWARM_DEV_CHECKOUT=%s\n' "$dev_checkout"
    printf 'SWARM_DEV_RELOAD_REQUEST_PATH=%s/development-reload.request\n' "$state_root"
    printf 'SWARM_DEV_RELOAD_STATUS_PATH=%s/development-reload.status\n' "$state_root"
  } > "$dev_config.tmp"
  mv -f "$dev_config.tmp" "$dev_config"
  rm -f "$state_root/development-reload.request"
  printf 'state=idle\n' > "$state_root/development-reload.status"
  install_units "$current"
  run_systemctl enable --now swarm-next-development-reload.path
  run_systemctl restart swarm-next-api.service
  wait_for_health || die "development mode could not restart the API"
  printf 'Development reload enabled for %s on %s\n' "$dev_checkout" "$health_url"
}

disable_development() {
  current=$(release_from_link "$install_root/current")
  [ -n "$current" ] || die "no current release is installed"
  run_systemctl disable --now swarm-next-development-reload.path >/dev/null 2>&1 || true
  rm -f "$dev_config" "$state_root/development-reload.request" "$state_root/development-reload.status"
  install_units "$current"
  run_systemctl restart swarm-next-api.service
  wait_for_health || die "API did not recover after disabling development mode"
  printf 'Development reload disabled; the current release remains active.\n'
}

reload_development() {
  [ -f "$dev_config" ] || die "development mode is not configured"
  dev_checkout=$(sed -n 's/^SWARM_DEV_CHECKOUT=//p' "$dev_config")
  dev_status_path=$(sed -n 's/^SWARM_DEV_RELOAD_STATUS_PATH=//p' "$dev_config")
  validate_dev_checkout "$dev_checkout"
  [ "$dev_status_path" = "$state_root/development-reload.status" ] || die "development status path is invalid"
  dev_reload_started=1
  printf 'state=building\n' > "$dev_status_path"
  rm -f "$state_root/development-reload.request"
  dev_build_root="$state_root/development-build"
  mkdir -p "$dev_build_root"
  clear_managed_directory "$dev_build_root"
  bundle_path=$("$dev_checkout/packaging/linux/build-development-release.sh" "$dev_build_root")
  [ -d "$bundle_path" ] || die "development builder did not return a release directory"
  "$bundle_path/swarm-next-package" update "$bundle_path"
}

wait_for_health() {
  attempts=0
  while [ "$attempts" -lt "$health_attempts" ]; do
    if "$curl_bin" --fail --silent --show-error --max-time 2 "$health_url" >/dev/null; then
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 1
  done
  return 1
}

wait_for_host() {
  host_release=$1
  attempts=0
  while [ "$attempts" -lt "$health_attempts" ]; do
    if SWARM_TERMINAL_SOCKET=$(terminal_socket) "$host_release/bin/swarmctl" status >/dev/null 2>&1; then
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 1
  done
  return 1
}

install_or_update() {
  validate_bundle
  mkdir -p "$install_root/releases" "$config_root" "$state_root/terminal-history" "$state_root/providers/claude" "$unit_root" "$bin_root" "$workspace_root" "$workspace_root/queen"
  chmod 0700 "$config_root" "$state_root"
  write_initial_config
  validate_config
  new_release=$(install_release)
  old_release=$(release_from_link "$install_root/current")
  host_release=$(release_from_link "$install_root/host-current")
  if [ -z "$host_release" ] && [ -n "$old_release" ]; then
    host_release=$old_release
    activate_host_link "$host_release"
  fi
  if [ -n "$host_release" ]; then
    host_protocol=$(cat "$host_release/PROTOCOL")
    [ "$host_protocol" = "$protocol" ] || die "protocol change requires an explicit compatibility migration"
  fi
  [ -z "$old_release" ] || create_update_backup "$old_release"
  previous_release=$(release_from_link "$install_root/previous")
  [ -z "$previous_release" ] || publish_assets "$previous_release"
  [ -z "$old_release" ] || publish_assets "$old_release"
  publish_assets "$new_release"

  if [ -z "$old_release" ]; then
    activate_link "$new_release"
    activate_host_link "$new_release"
    install_units "$new_release"
    if run_systemctl enable --now swarm-next.target \
      && run_systemctl enable --now swarm-next-host-reconcile.path swarm-next-host-reconcile.timer \
      && wait_for_health && wait_for_host "$new_release"; then
      prune_superseded_releases
      printf 'Swarm Next %s is healthy at %s\n' "$version" "$health_url"
      return
    fi
    run_systemctl stop swarm-next.target || true
    die "initial installation failed health verification"
  fi

  [ "$old_release" = "$new_release" ] || ln -sfn "$old_release" "$install_root/previous"
  activate_link "$new_release"
  install_units "$new_release"
  rollback_release=$old_release
  if run_systemctl enable --now swarm-next.target \
    && run_systemctl enable --now swarm-next-host-reconcile.path swarm-next-host-reconcile.timer \
    && run_systemctl restart swarm-next-api.service && wait_for_health; then
    rollback_release=
    update_rollback=
    prune_superseded_releases
    printf 'Swarm Next API %s is healthy at %s; terminal host %s was preserved\n' \
      "$version" "$health_url" "$(basename "$host_release")"
    return
  fi
  activate_link "$old_release"
  install_units "$old_release"
  restore_update_database
  run_systemctl restart swarm-next-api.service
  if wait_for_health; then
    rollback_release=
    die "new API failed health verification; previous API release restored"
  fi
  rollback_release=
  die "new API and previous API both failed health verification"
}

rollback() {
  previous=$(release_from_link "$install_root/previous")
  current=$(release_from_link "$install_root/current")
  host_release=$(release_from_link "$install_root/host-current")
  [ -n "$previous" ] || die "no previous release is retained"
  [ -n "$current" ] || die "no current release is installed"
  [ -n "$host_release" ] || die "no terminal host release is installed"
  [ "$(cat "$previous/PROTOCOL")" = "$(cat "$host_release/PROTOCOL")" ] || die "rollback API is incompatible with the active terminal host"
  rollback_release=$current
  activate_link "$previous"
  ln -sfn "$current" "$install_root/previous"
  install_units "$previous"
  run_systemctl restart swarm-next-api.service
  wait_for_health || die "rollback release failed health verification"
  rollback_release=
  printf 'Swarm Next API rolled back to %s; terminal host %s was preserved\n' \
    "$(basename "$previous")" "$(basename "$host_release")"
}

reconcile_host() {
  reconcile_mode=${1:-required}
  current=$(release_from_link "$install_root/current")
  host_release=$(release_from_link "$install_root/host-current")
  [ -n "$current" ] || die "no current release is installed"
  [ -n "$host_release" ] || die "no terminal host release is installed"
  [ "$current" != "$host_release" ] || { printf 'Terminal host already uses %s\n' "$(basename "$current")"; return; }
  [ "$(cat "$current/PROTOCOL")" = "$(cat "$host_release/PROTOCOL")" ] || die "terminal host protocol migration is required"

  SWARM_TERMINAL_SOCKET=$(terminal_socket) "$host_release/bin/swarmctl" drain >/dev/null
  drain_release=$host_release
  status=$(SWARM_TERMINAL_SOCKET=$(terminal_socket) "$host_release/bin/swarmctl" status)
  running=$(printf '%s\n' "$status" | sed -n 's/.*"running_sessions":[[:space:]]*\([0-9][0-9]*\).*/\1/p')
  case "$running" in *[!0-9]*|"") die "terminal host returned invalid status";; esac
  if [ "$running" -ne 0 ]; then
    if [ "$reconcile_mode" = "if-idle" ]; then
      SWARM_TERMINAL_SOCKET=$(terminal_socket) \
        "$host_release/bin/swarmctl" cancel-drain >/dev/null 2>&1 || true
      drain_release=
      printf 'Terminal host update remains deferred; %s sessions are active\n' "$running"
      return
    fi
    die "terminal host update deferred; $running sessions remain"
  fi

  activate_host_link "$current"
  install_units "$current"
  if run_systemctl restart swarm-next-terminal-host.service && wait_for_host "$current"; then
    drain_release=
    printf 'Terminal host now uses %s\n' "$(basename "$current")"
    return
  fi
  activate_host_link "$host_release"
  install_units "$current"
  run_systemctl restart swarm-next-terminal-host.service || true
  wait_for_host "$host_release" || true
  drain_release=
  die "terminal host restart failed; previous host release restored"
}

migrate_protocol() {
  validate_bundle
  validate_config
  new_release=$(install_release)
  old_release=$(release_from_link "$install_root/current")
  host_release=$(release_from_link "$install_root/host-current")
  [ -n "$old_release" ] || die "no current release is installed"
  [ -n "$host_release" ] || die "no terminal host release is installed"
  [ "$(cat "$host_release/PROTOCOL")" != "$protocol" ] || die "protocol is unchanged; use update and reconcile-host"

  SWARM_TERMINAL_SOCKET=$(terminal_socket) "$host_release/bin/swarmctl" drain >/dev/null
  drain_release=$host_release
  status=$(SWARM_TERMINAL_SOCKET=$(terminal_socket) "$host_release/bin/swarmctl" status)
  running=$(printf '%s\n' "$status" | sed -n 's/.*"running_sessions":[[:space:]]*\([0-9][0-9]*\).*/\1/p')
  case "$running" in *[!0-9]*|"") die "terminal host returned invalid status";; esac
  [ "$running" -eq 0 ] || die "protocol migration deferred; $running sessions remain"

  create_update_backup "$old_release"

  previous_release=$(release_from_link "$install_root/previous")
  [ -z "$previous_release" ] || publish_assets "$previous_release"
  publish_assets "$old_release"
  publish_assets "$new_release"
  [ "$old_release" = "$new_release" ] || ln -sfn "$old_release" "$install_root/previous"

  rollback_release=$old_release
  rollback_host_release=$host_release
  run_systemctl stop swarm-next.target || true
  activate_link "$new_release"
  activate_host_link "$new_release"
  install_units "$new_release"
  if run_systemctl enable --now swarm-next.target && wait_for_host "$new_release" && wait_for_health; then
    drain_release=
    rollback_release=
    rollback_host_release=
    update_rollback=
    prune_superseded_releases
    printf 'Swarm Next protocol migrated to %s and is healthy at %s\n' "$version" "$health_url"
    return
  fi
  die "protocol migration failed health verification; previous release will be restored"
}

uninstall_product() {
  run_systemctl disable --now swarm-next.target 2>/dev/null || true
  rm -f "$unit_root/swarm-next-terminal-host.service" "$unit_root/swarm-next-api.service" \
    "$unit_root/swarm-next-host-reconcile.service" "$unit_root/swarm-next-host-reconcile.path" "$unit_root/swarm-next-host-reconcile.timer" \
    "$unit_root/swarm-next.target"
  run_systemctl daemon-reload
  [ ! -L "$bin_root/swarmctl" ] || rm -f "$bin_root/swarmctl"
  rm -rf "$install_root"
  printf 'Application removed. Configuration and state were preserved in %s and %s.\n' "$config_root" "$state_root"
}

validate_roots
case "$action" in
  install|update) install_or_update;;
  enable-development) enable_development;;
  disable-development) disable_development;;
  reload-development) reload_development;;
  rollback) rollback;;
  reconcile-host) reconcile_host;;
  reconcile-host-if-idle) reconcile_host if-idle;;
  migrate-protocol) migrate_protocol;;
  uninstall) uninstall_product;;
  restore) restore_database;;
  *) die "usage: swarm-next-package <install|update|migrate-protocol> RELEASE_DIR | enable-development CHECKOUT | disable-development | reload-development | restore DATABASE | rollback | reconcile-host | reconcile-host-if-idle | uninstall";;
esac
