[Unit]
Description=Swarm terminal host
PartOf=swarm.target

[Service]
Type=simple
EnvironmentFile=@CONFIG_ROOT@/swarm.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SWARM_TERMINAL_SOCKET=%t/swarm/terminal.sock
Environment=SWARM_TERMINAL_HISTORY_DIR=@STATE_ROOT@/terminal-history
Environment=SWARM_CLAUDE_SETTINGS_PATH=%h/.claude/settings.json
ExecStart=@INSTALL_ROOT@/host-current/bin/swarm-terminal-host
Restart=on-failure
RestartSec=2s
RuntimeDirectory=swarm
RuntimeDirectoryMode=0700
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# NOT ProtectHome=read-only, and this is deliberate rather than an omission.
#
# This unit runs the operator's coding agents. They write across $HOME as a
# matter of course — Claude Code's own ~/.claude.json, git config, language
# toolchain caches, whatever a task needs — so a read-only home is at odds with
# what the service is for, and every tool that writes somewhere unlisted becomes
# a bug nobody can see.
#
# It failed in the worst available way. ReadWritePaths on a single FILE is a
# bind mount of one inode, and Claude Code writes its config by atomic replace:
# temp file, then rename over the target. The rename detaches from the mounted
# inode, so the write reports success and the file never changes. Files inside a
# bind-mounted DIRECTORY are unaffected, which is why credentials in ~/.claude
# persisted while ~/.claude.json stayed byte-identical through repeated
# onboarding — 517 bytes, same inode, same mtime, on 2026-08-26.
#
# The result was a fresh install that asked for login and full onboarding on
# every wake, with nothing anywhere reporting a failed write.
#
# ProtectSystem=strict still protects the system tree. Home is the thing this
# service exists to work in.
ReadWritePaths=@STATE_ROOT@
ReadWritePaths=@WORKSPACE_ROOT@
UMask=0077

[Install]
WantedBy=swarm.target
