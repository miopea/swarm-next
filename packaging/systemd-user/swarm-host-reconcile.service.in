[Unit]
Description=Apply a requested or safely deferred Swarm worker engine update
After=swarm-terminal-host.service swarm-api.service
# Reconciliation restarts this service itself. Requires would stop the updater
# mid-command, skipping health verification and rollback after the restart.
Wants=swarm-terminal-host.service

[Service]
Type=oneshot
ExecStart=@INSTALL_ROOT@/current/swarm-package reconcile-host-requested
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@INSTALL_ROOT@
ReadWritePaths=@UNIT_ROOT@
ReadWritePaths=@STATE_ROOT@
# reconcile_host relinks the terminal-host launcher, which lives here.
ReadWritePaths=@BIN_ROOT@
