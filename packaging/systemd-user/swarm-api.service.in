[Unit]
Description=Swarm application and web UI
PartOf=swarm.target
After=swarm-terminal-host.service
Wants=swarm-terminal-host.service

[Service]
Type=simple
EnvironmentFile=@CONFIG_ROOT@/swarm.env
EnvironmentFile=-@CONFIG_ROOT@/swarm-dev.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Limit glibc arena proliferation and retained free space in the long-lived API.
# This is API-only: provider and terminal-host allocator policy is unchanged.
# An operator EnvironmentFile or service drop-in can override this default.
Environment=MALLOC_ARENA_MAX=2
Environment=SWARM_TERMINAL_SOCKET=%t/swarm/terminal.sock
Environment=SWARM_WEB_ROOT=@INSTALL_ROOT@/current/web
Environment=SWARM_ASSET_ROOT=@INSTALL_ROOT@/assets
Environment=SWARM_DATABASE_PATH=@STATE_ROOT@/swarm.sqlite3
Environment=SWARM_MAINTENANCE_REQUEST_PATH=@STATE_ROOT@/worker-engine-maintenance.request
Environment=SWARM_OPERATOR_CONFIG_PATH=@CONFIG_ROOT@/swarm.env
ExecStart=@INSTALL_ROOT@/current/bin/swarm-api
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# NOT ProtectHome=read-only, and this is deliberate rather than an omission.
#
# This service REPORTS on what workers can do; the terminal host DOES it, and
# that unit has never had a read-only home. Sandboxing only the reporter meant
# it answered from a namespace nothing else lived in, found every workspace
# unwritable, and marked every worker Blocked while the workers ran perfectly.
#
# It was patched twice without being removed. First by adding
# ReadWritePaths=@WORKSPACE_ROOT@ so the one configured root was writable again,
# then in code by filtering EROFS out of the fault check. Both narrowed the
# symptom to workspaces outside that single root, and on 2026-09-11 a freshly
# built machine showed all eight workers Blocked while answering broadcasts.
# Operator: "Swarm should not be limited in where it can write, we are
# overthinking it. This is a dev tool."
#
# Originally found on a fresh WSL install on 2026-08-26, after the EROFS was
# read as a failing disk and chased through dumpe2fs, dmesg and Windows free
# space. The disk was healthy the whole time. It hid on the machine it was
# written on, because there ~/projects is a separate filesystem that
# ProtectHome does not cover.
#
# ProtectSystem=strict still protects the system tree. Home is what both
# services exist to work in, and they must agree about it.
ReadWritePaths=@STATE_ROOT@
ReadWritePaths=@WORKSPACE_ROOT@
# The operator rotates their token in Settings, which rewrites this file so the
# new value is also what systemd loads on the next start.
ReadWritePaths=@CONFIG_ROOT@
# TOLERANT, because a fresh machine does not have these yet.
#
# Claude Code creates ~/.claude and ~/.claude.json on its first run, so on a
# brand-new install they do not exist when these units first start. Without the
# leading '-' systemd treats a missing path as a failure to build the namespace,
# and the first login has nowhere to persist — the operator logs in, it works,
# and every later session asks again.
#
# The dev-reload unit two files over already does this for ~/.cargo and the pnpm
# store, for exactly the same reason. This is that lesson, applied where it was
# missed.
ReadWritePaths=-%h/.claude
ReadWritePaths=-%h/.claude.json
UMask=0077

[Install]
WantedBy=swarm.target
