[Unit]
Description=Build and activate the configured Swarm development checkout
After=swarm-terminal-host.service

[Service]
Type=oneshot
EnvironmentFile=@CONFIG_ROOT@/swarm-dev.env
Environment=PATH=%h/.cargo/bin:%h/.local/share/pnpm:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@INSTALL_ROOT@/current/swarm-package reload-development
TimeoutStartSec=45min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@INSTALL_ROOT@ @STATE_ROOT@ @DEV_CHECKOUT@
# The rebuild ends in `swarm-package update`, which relinks swarmctl here.
ReadWritePaths=@BIN_ROOT@
ReadWritePaths=@UNIT_ROOT@
ReadWritePaths=-%h/.cargo -%h/.cache -%h/.local/share/pnpm
UMask=0077
